# dependencies
/node_modules

# build output
/dist
*.tsbuildinfo

# runtime state — NEVER commit: holds data/secret.key (env encryption key, 0600)
/data

# testing
/coverage

# logs
**/*.log
npm-debug.log*

# secrets and local env
*.pem
.env
.env.*
!.env.example

# archives and traces
**/*.trace
**/*.zip
**/*.tar.gz
**/*.tgz
**/*.bun

# other package managers — bun.lock is the committed lockfile
package-lock.json
yarn.lock
pnpm-lock.yaml

# misc
.DS_Store
