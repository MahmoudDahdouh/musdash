{
  "name": "mosdash",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "bun build --compile --minify --sourcemap src/index.ts --outfile dist/mosdash",
    "rss": "bun run scripts/measure-rss.ts",
    "gate:rss": "bun run build && bun run rss",
    "dev": "bun run --watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "prettier --write . && biome lint --error-on-warnings .",
    "ci": "prettier --check . && biome ci --error-on-warnings .",
    "prepare": "husky"
  },
  "dependencies": {
    "@elysiajs/html": "^1.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "eta": "^4.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "^1.4.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "module": "src/index.js"
}
