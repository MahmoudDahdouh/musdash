<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= it.title %> · mosdash</title>
    <link rel="stylesheet" href="/assets/app.css" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='14'>▲</text></svg>"
    />
    <script defer src="/assets/alpine.js"></script>
  </head>
  <body>
    <% if (it.user) { %>
    <header class="topbar">
      <a class="brand" href="/">mosdash</a>
      <nav>
        <span class="muted"><%= it.user.email %></span>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="csrf" value="<%= it.csrf %>" />
          <button class="link" type="submit">Log out</button>
        </form>
      </nav>
    </header>
    <% } %>
    <main class="<%= it.wide ? 'wide' : '' %>">
      <% if (it.flash) { %>
      <div class="flash flash-<%= it.flash.kind %>"><%= it.flash.text %></div>
      <% } %> <%~ it.body %>
    </main>
  </body>
</html>
