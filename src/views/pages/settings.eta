<div class="page-head">
  <div class="page-title"><h1>Settings</h1></div>
</div>

<% if (it.flash) { %>
<div
  class="notice notice-<%= it.flash.kind %>"
  role="<%= it.flash.kind === 'error' ? 'alert' : 'status' %>"
>
  <svg class="icon" aria-hidden="true"><use href="#i-<%= it.flash.kind === 'error' ? 'x-circle' : 'check' %>" /></svg>
  <div><%= it.flash.text %></div>
</div>
<% } %>

<% if (it.restarting) { %>
<div class="card stack" x-data x-init="setTimeout(() => location.reload(), 6000)">
  <h3 class="card-title">Restarting musdash</h3>
  <p class="muted">
    This page reloads in a few seconds. If it does not,
    <a href="/settings">reload it yourself</a>.
  </p>
</div>
<% } %>

<div class="card stack">
  <h3 class="card-title">Dashboard address</h3>

  <% if (!it.host.host) { %>
  <p class="muted">
    musdash currently answers on this server's address over plain HTTP. No
    certificate authority issues certificates for a bare IP address, so there is
    no HTTPS to be had until you give it a name. Point a DNS A record at this
    server, enter the name below, and Caddy obtains a certificate automatically.
  </p>
  <% } else { %>
  <p class="muted">
    Reachable at
    <a href="https://<%= it.host.host %>/" rel="noreferrer">https://<%= it.host.host %>/</a><%
      %><% if (it.host.source === "environment") { %>, from
    <code>MUSDASH_DASHBOARD_HOST</code><% } %>. This server's own address keeps
    working over plain HTTP as a fallback, so a DNS or certificate problem
    cannot lock you out.
  </p>
  <% } %>

  <% if (it.host.applyPending) { %>
  <div class="notice notice-ok" role="status">
    <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
    <div>
      Saved. Applying it to the proxy — reload in a moment to see the result.
    </div>
  </div>
  <% } %>

  <% if (it.host.envHostShadowed) { %>
  <div class="notice notice-error" role="alert">
    <svg class="icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
    <div>
      <code>MUSDASH_DASHBOARD_HOST</code> is also set in
      <code>musdash.env</code>. This page wins now, so that line is ignored and
      you can delete it.
    </div>
  </div>
  <% } %>

  <% if (it.host.check && it.host.check.dns === "mismatch") { %>
  <div class="notice notice-error" role="alert">
    <svg class="icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
    <div>
      <strong><%= it.host.host %></strong> resolves to
      <%= it.host.check.resolved.join(", ") %>, but this server answers on
      <%= it.host.check.local.join(", ") %>. Caddy cannot obtain a certificate
      until DNS points here. Nothing is blocked — the name is saved either way,
      and this check cannot see an address that reaches you through NAT or a
      proxying CDN.
    </div>
  </div>
  <% } else if (it.host.check && it.host.check.dns === "unresolved") { %>
  <div class="notice notice-error" role="alert">
    <svg class="icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
    <div>
      <strong><%= it.host.host %></strong> does not resolve yet. DNS changes can
      take a few minutes to propagate; the name is saved and will start working on
      its own.
    </div>
  </div>
  <% } %>

  <% if (it.host.check && !it.host.check.reachable) { %>
  <div class="notice notice-error" role="alert">
    <svg class="icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
    <div>
      <strong>The proxy cannot reach this dashboard.</strong>
      <%= it.host.check.reachError %>. This is almost always the host firewall
      dropping traffic from the Docker bridge. On Ubuntu:
      <pre><code>ufw allow in on docker0 to any port 8000 proto tcp
ufw deny 8000/tcp</code></pre>
    </div>
  </div>
  <% } %>

  <form method="post" action="/settings/dashboard-host" class="stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="dashboard-host">Hostname</label>
      <input
        id="dashboard-host"
        name="host"
        value="<%= it.host.host || '' %>"
        placeholder="mus.example.com"
        autocomplete="off"
        spellcheck="false"
        aria-describedby="dashboard-host-hint"
      />
      <p class="hint" id="dashboard-host-hint">
        The A record must already point at this server. Leave it empty to go
        back to answering on the bare address. Applies immediately — no restart
        needed.
      </p>
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>

  <p class="muted">
    Listening on <code><%= it.host.bindAddress %></code>. That port is reachable
    from every interface, so your firewall — not the bind address — is what
    keeps it off the internet.
  </p>
</div>

<div class="card stack">
  <h3 class="card-title">Restart musdash</h3>
  <p class="muted">
    The dashboard address above applies without one. A restart is how you pick
    up the settings that still live in <code>musdash.env</code> — the ACME
    email, the wildcard domain, the public URL. It takes about three seconds.
  </p>

  <% if (it.host.restart.blockedReason) { %>
  <div class="notice notice-error" role="alert">
    <svg class="icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
    <div>
      Not right now: <%= it.host.restart.blockedReason %>.
    </div>
  </div>
  <% } %>

  <form
    method="post"
    action="/settings/restart"
    data-confirm
    data-confirm-title="Restart musdash?"
    data-confirm-body="The dashboard is unavailable for about three seconds. Running deployments are not interrupted — a restart is refused while any job is in flight."
    data-confirm-label="Restart"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <button
      class="btn btn-primary"
      type="submit"
      <%= it.host.restart.available && !it.host.restart.blockedReason ? '' : 'disabled' %>
    >
      <svg class="icon" aria-hidden="true"><use href="#i-rotate-ccw" /></svg>
      Restart musdash
    </button>
  </form>

  <p class="muted">
    <% if (!it.host.restart.available) { %>
    Nothing is supervising this process, so the button would stop it rather than
    restart it. Restart it the way you started it, or over SSH:
    <% } else { %>
    Or over SSH:
    <% } %>
    <code><%= it.host.restart.command %></code>
  </p>
</div>

<div class="card stack">
  <h3 class="card-title">GitHub</h3>
  <p class="muted">
    Connecting a GitHub App lets musdash read your repositories, build them from
    source, and deploy automatically when you push.
  </p>

  <% if (!it.publicUrl) { %>
  <div class="notice notice-error" role="alert">
    <svg class="icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
    <div>
      <strong>This dashboard has no domain yet.</strong>
      GitHub has to reach this instance to deliver the registration callback and
      push webhooks, and it cannot do that over a bare IP address. Set a domain
      you have pointed at this server under <em>Dashboard address</em> above —
      a certificate follows within a few seconds, and GitHub can be connected
      straight after. No restart needed.
    </div>
  </div>
  <% } %>

  <% if (!it.app) { %>
  <p class="muted">
    No GitHub App is connected. Creating one sends you to GitHub, where you
    confirm the App and choose which repositories it may read. musdash never
    asks for your GitHub password and stores only the credentials GitHub hands
    back, encrypted at rest.
  </p>
  <form method="post" action="/settings/github/connect">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <button class="btn btn-primary" type="submit" <%= it.publicUrl ? '' : 'disabled' %>>
      <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
      Connect GitHub
    </button>
  </form>
  <% if (!it.publicUrl) { %>
  <p class="muted">
    <small>Connecting stays unavailable until a public URL is configured.</small>
  </p>
  <% } %>

  <% } else { %>
  <dl class="kv">
    <dt>App</dt>
    <dd class="mono"><%= it.app.slug %></dd>
    <dt>App ID</dt>
    <dd class="mono"><%= it.app.appId %></dd>
  </dl>

  <div class="row gap wrap">
    <a
      class="btn"
      href="https://github.com/apps/<%= it.app.slug %>/installations/new"
      target="_blank"
      rel="noopener"
    >
      Install on a repository
    </a>
    <form method="post" action="/settings/github/sync" class="inline">
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button class="btn" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-rotate-ccw" /></svg>
        Sync installations
      </button>
    </form>
  </div>
  <p class="muted">
    <small>
      Install the App on the accounts and repositories you want to deploy from,
      then sync so musdash sees them.
    </small>
  </p>

  <h4>Installations</h4>
  <% if (it.installations.length === 0) { %>
  <p class="muted">
    No installations yet. Install the App on an account, then press Sync
    installations.
  </p>
  <% } else { %>
  <ul class="plain installations">
    <% it.installations.forEach(function (i) { %>
    <li class="row between">
      <span class="mono"><%= i.accountLogin %></span>
      <span class="muted"><small>installation <%= i.installationId %></small></span>
    </li>
    <% }) %>
  </ul>
  <% } %>
  <% } %>
</div>

<% if (it.app) { %>
<div class="card card-danger stack">
  <h3 class="card-title">Disconnect GitHub</h3>
  <p class="muted">
    Removes the App and its installations from musdash. Existing resources keep
    their repository and branch, but lose their link to GitHub: they can no
    longer build private repositories or deploy on push until you connect again.
    The App itself is not deleted from GitHub — remove it there too if you want
    it gone.
  </p>
  <% if (it.linkedResourceCount > 0) { %>
  <p class="muted">
    <strong><%= it.linkedResourceCount %></strong>
    resource<%= it.linkedResourceCount === 1 ? '' : 's' %> currently
    build<%= it.linkedResourceCount === 1 ? 's' : '' %> from this connection.
  </p>
  <% } %>
  <form
    method="post"
    action="/settings/github/disconnect"
    data-confirm
    data-confirm-danger
    data-confirm-title="Disconnect GitHub?"
    data-confirm-body="<%= it.linkedResourceCount > 0 ? it.linkedResourceCount + ' resource(s) build from this connection and will stop deploying on push or building private repositories until GitHub is connected again.' : 'The App and its installations are removed from musdash. Nothing is deleted on GitHub.' %>"
    data-confirm-label="Disconnect"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <input type="hidden" name="confirm" value="disconnect" />
    <button class="btn btn-danger" type="submit">
      <svg class="icon" aria-hidden="true"><use href="#i-x" /></svg>
      Disconnect GitHub
    </button>
  </form>
</div>
<% } %>
