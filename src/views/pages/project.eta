<div class="page-head">
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a class="link-quiet" href="/projects">Projects</a></li>
      <li aria-current="page"><%= it.project.name %></li>
    </ol>
  </nav>
  <div class="page-title"><h1><%= it.project.name %></h1></div>
  <% if (it.tab === 'resources' && !it.deleting) { %>
  <div class="actions">
    <button type="button" class="btn btn-quiet" data-open="new-env" commandfor="new-env" command="show-modal">
      <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
      New environment
    </button>
  </div>
  <% } %>
</div>

<% if (it.deleting) { %>
<div class="notice notice-warn" role="status">
  <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
  <div>
    This project is being deleted. Its resources are removed one by one, and
    then the project disappears from the list.
  </div>
</div>
<% } %>

<nav class="tabs" aria-label="Project sections">
  <% [['resources', 'Resources'], ['env', 'Variables'], ['settings', 'Settings']].forEach(function (t) { %>
  <a href="/p/<%= it.project.id %>?tab=<%= t[0] %>" <%~ it.tab === t[0] ? 'aria-current="page"' : '' %>><%= t[1] %></a>
  <% }) %>
</nav>

<% if (it.tab === 'settings') { %>
<%
  var resourceTotal = it.environments.reduce(function (n, e) { return n + e.resources.length }, 0)
%>
<div class="card stack">
  <h2 class="card-title">Project</h2>
  <form method="post" action="/p/<%= it.project.id %>/settings" class="stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="project-name">Name</label>
      <%/* src/names.ts; ( ) [ ] and - escaped for the v flag (M-1). */%>
      <input id="project-name" name="name" value="<%= it.project.name %>" required maxlength="60" pattern="[A-Za-z0-9 \(\)\[\]._\-]{1,60}" />
      <p class="error">Use letters, digits, spaces and ( ) [ ] . _ -, up to 60 characters.</p>
    </div>
    <div class="field">
      <label class="label" for="project-description">Description <span class="opt">optional</span></label>
      <input id="project-description" name="description" value="<%= it.project.description || '' %>" maxlength="200" />
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
</div>

<% if (!it.deleting) { %>
<div class="card card-danger stack">
  <h2 class="card-title">Delete project</h2>
  <p class="muted">
    Removes <%= it.environments.length %> environment<%= it.environments.length === 1 ? '' : 's' %>
    and <%= resourceTotal %> resource<%= resourceTotal === 1 ? '' : 's' %>: every
    container, route and domain, every variable, and all deployment history.
    This cannot be undone.
  </p>
  <form
    method="post"
    action="/p/<%= it.project.id %>/delete"
    class="stack"
  >
    <%/* No data-confirm: typing the name is the confirmation, and a second
         prompt after it would only train people to click through both. */%>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="project-confirm">Type <span class="mono"><%= it.project.name %></span> to confirm</label>
      <input id="project-confirm" name="confirm" required autocomplete="off" spellcheck="false" />
    </div>
    <div class="row end">
      <button class="btn btn-danger" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
        Delete this project
      </button>
    </div>
  </form>
</div>
<% } %>
<% } %>

<% if (it.tab === 'env') { %>
<div class="card stack">
  <h2 class="card-title">Project variables</h2>
  <p class="muted">
    Inherited by every resource in every environment of this project. An
    environment or a resource can override any of them. Reference another
    variable with <code>${OTHER}</code>, and write <code>$$</code> for a
    literal <code>$</code>.
  </p>
  <dl class="kv">
    <dt>Currently set</dt>
    <dd>
      <% if (it.projectEnv.length) { %>
      <ul class="chips" role="list">
        <% it.projectEnv.forEach(function (v) { %><li><code class="chip"><%= v.key %></code></li><% }) %>
      </ul>
      <% } else { %>
      <span class="muted">Nothing yet</span>
      <% } %>
    </dd>
  </dl>
  <form
    method="post"
    action="/p/<%= it.project.id %>/env"
    class="stack"
    autocomplete="off"
    data-env-form
    data-confirm
    data-confirm-title="Save these variables?"
    data-confirm-body="A variable you removed from the boxes is deleted, from every resource that inherits it. Changes take effect on each resource's next deploy."
    data-confirm-label="Save variables"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="scope-boxes">
      <div class="field">
        <label class="label" for="project-vars-runtime">Runtime only</label>
        <textarea id="project-vars-runtime" name="runtime" rows="6" spellcheck="false" placeholder="LOG_LEVEL=info"><%= it.envText ? it.envText.runtime : '' %></textarea>
      </div>
      <div class="field">
        <label class="label" for="project-vars-build">Build only</label>
        <textarea id="project-vars-build" name="build" rows="6" spellcheck="false" placeholder="NPM_TOKEN=..."><%= it.envText ? it.envText.build : '' %></textarea>
      </div>
      <div class="field">
        <label class="label" for="project-vars-both">Both</label>
        <textarea id="project-vars-both" name="both" rows="6" spellcheck="false" placeholder="NODE_ENV=production"><%= it.envText ? it.envText.both : '' %></textarea>
      </div>
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save variables
      </button>
    </div>
  </form>
</div>

<%
  /*
   * The id below duplicates the one on the resources tab's <section>. Safe,
   * and deliberate: the two tabs are mutually exclusive in a single render, so
   * only one is ever in the DOM, and the environment POST redirects back to
   * this fragment.
   */
%>
<% it.environments.forEach(function (env) { %>
<div class="card stack" id="env-<%= env.environment.id %>">
  <h2 class="card-title"><%= env.environment.name %> variables</h2>
  <p class="muted">
    Inherited by the <%= env.resources.length %> resource<%= env.resources.length === 1 ? '' : 's' %>
    in this environment, overriding anything of the same name set at the
    project level.
  </p>
  <dl class="kv">
    <dt>Currently set</dt>
    <dd>
      <% if (env.sharedEnv.length) { %>
      <ul class="chips" role="list">
        <% env.sharedEnv.forEach(function (v) { %><li><code class="chip"><%= v.key %></code></li><% }) %>
      </ul>
      <% } else { %>
      <span class="muted">Nothing yet</span>
      <% } %>
    </dd>
  </dl>
  <form
    method="post"
    action="/e/<%= env.environment.id %>/env"
    class="stack"
    autocomplete="off"
    data-env-form
    data-confirm
    data-confirm-title="Save these variables?"
    data-confirm-body="A variable you removed from the boxes is deleted, from every resource in <%= env.environment.name %> that inherits it. Changes take effect on each resource's next deploy."
    data-confirm-label="Save variables"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="scope-boxes">
      <div class="field">
        <label class="label" for="env-vars-<%= env.environment.id %>-runtime">Runtime only</label>
        <textarea id="env-vars-<%= env.environment.id %>-runtime" name="runtime" rows="6" spellcheck="false" placeholder="DATABASE_URL=postgres://..."><%= env.envText ? env.envText.runtime : '' %></textarea>
      </div>
      <div class="field">
        <label class="label" for="env-vars-<%= env.environment.id %>-build">Build only</label>
        <textarea id="env-vars-<%= env.environment.id %>-build" name="build" rows="6" spellcheck="false"><%= env.envText ? env.envText.build : '' %></textarea>
      </div>
      <div class="field">
        <label class="label" for="env-vars-<%= env.environment.id %>-both">Both</label>
        <textarea id="env-vars-<%= env.environment.id %>-both" name="both" rows="6" spellcheck="false"><%= env.envText ? env.envText.both : '' %></textarea>
      </div>
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save variables
      </button>
    </div>
  </form>
</div>
<% }) %>
<% } %>

<% if (it.tab === 'resources') { %>
<%
  /* One error line per kind of name field; the server's own checks say the
     same thing. A resource name is display text (D65); an environment name
     is still a DNS label. The pattern escapes ( ) [ ] and - because browsers
     compile it with the v flag, which refuses them bare (M-1). */
  var nameError = 'Use lowercase letters, digits and dashes, up to 32 characters.'
  var resNameError = 'Use letters, digits, spaces and ( ) [ ] . _ -, up to 60 characters.'
  var resNamePattern = '[A-Za-z0-9 \\(\\)\\[\\]._\\-]{1,60}'
%>
<% it.environments.forEach(function (env) { %>
<% var res = 'new-res-' + env.environment.id, git = 'new-git-' + env.environment.id %>
<% var ren = 'rename-env-' + env.environment.id %>
<section class="env" id="env-<%= env.environment.id %>">
  <div class="env-head">
    <h2><%= env.environment.name %></h2>
    <% if (env.deleting || it.deleting) { %>
    <span class="status status-queued">Deleting</span>
    <% } else { %>
    <div class="row gap">
      <button type="button" class="btn btn-quiet btn-sm" data-open="<%= ren %>" commandfor="<%= ren %>" command="show-modal">
        Rename
      </button>
      <form
        method="post"
        action="/e/<%= env.environment.id %>/delete"
        class="inline"
        data-confirm
        data-confirm-danger
        data-confirm-title="Delete <%= env.environment.name %>?"
        data-confirm-body="<%= env.resources.length %> resource<%= env.resources.length === 1 ? '' : 's' %> in it <%= env.resources.length === 1 ? 'is' : 'are' %> removed, with <%= env.resources.length === 1 ? 'its' : 'their' %> containers, routes, domains, variables and history, and so are the environment's shared variables. This cannot be undone."
        data-confirm-label="Delete environment"
      >
        <input type="hidden" name="csrf" value="<%= it.csrf %>" />
        <button class="btn btn-quiet btn-sm btn-icon" type="submit" aria-label="Delete <%= env.environment.name %>">
          <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
        </button>
      </form>
      <button type="button" class="btn btn-sm" data-open="<%= git %>" commandfor="<%= git %>" command="show-modal">
        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
        From repository
      </button>
      <button type="button" class="btn btn-primary btn-sm" data-open="<%= res %>" commandfor="<%= res %>" command="show-modal">
        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
        Add resource
      </button>
    </div>
    <% } %>
  </div>

  <% if (env.resources.length === 0) { %>
  <div class="empty empty-sm card">
    <p class="muted">
      Nothing deployed here yet. Add a resource with a public Docker image such
      as <code>nginx:alpine</code>.
    </p>
  </div>
  <% } else { %>
  <div class="grid">
    <% env.resources.forEach(function (r) { %>
    <a class="card resource" href="/r/<%= r.resource.id %>">
      <div class="row between gap">
        <h3 class="card-title"><%= r.resource.name %></h3>
        <%~ include("@status", { state: r.state, live: false }) %>
      </div>
      <p class="muted mono"><%= r.image %></p>
      <div class="meta">
        <% if (r.domainCount > 0) { %><span><%= r.domainCount %> domain<%= r.domainCount === 1 ? '' : 's' %></span><% } %>
        <span><%= r.resource.memoryLimitMb %> MB</span>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</section>

<dialog id="<%= ren %>" aria-labelledby="<%= ren %>-title">
  <form method="post" action="/e/<%= env.environment.id %>/settings" class="stack">
    <header class="dialog-head">
      <h2 id="<%= ren %>-title">Rename <%= env.environment.name %></h2>
    </header>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="<%= ren %>-name">Name</label>
      <input id="<%= ren %>-name" name="name" value="<%= env.environment.name %>" required pattern="[a-z0-9\-]{1,32}" autocomplete="off" aria-describedby="<%= ren %>-hint" />
      <p class="hint" id="<%= ren %>-hint">Existing domains keep working; nothing else changes.</p>
      <p class="error"><%= nameError %></p>
    </div>
    <div class="dialog-foot">
      <button type="button" class="btn" data-close commandfor="<%= ren %>" command="close">Cancel</button>
      <button type="submit" class="btn btn-primary">Rename</button>
    </div>
  </form>
</dialog>

<dialog id="<%= res %>" aria-labelledby="<%= res %>-title">
  <form method="post" action="/e/<%= env.environment.id %>/resources" class="stack">
    <header class="dialog-head">
      <h2 id="<%= res %>-title">Add resource to <%= env.environment.name %></h2>
    </header>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="<%= res %>-name">Name</label>
      <input id="<%= res %>-name" name="name" required maxlength="60" pattern="<%= resNamePattern %>" placeholder="Web (prod)" aria-describedby="<%= res %>-name-hint" />
      <p class="hint" id="<%= res %>-name-hint">Any name you like. Image tags and the automatic domain use a lowercase form of it.</p>
      <p class="error"><%= resNameError %></p>
    </div>
    <div class="field">
      <label class="label" for="<%= res %>-image">Docker image</label>
      <input id="<%= res %>-image" name="image" required placeholder="nginx:alpine" />
    </div>
    <div class="field">
      <label class="label" for="<%= res %>-port">Container port <span class="opt">optional</span></label>
      <input id="<%= res %>-port" name="containerPort" type="number" min="1" max="65535" placeholder="80" aria-describedby="<%= res %>-port-hint" />
      <p class="hint" id="<%= res %>-port-hint">The port the app listens on. Required to expose it over HTTPS.</p>
    </div>
    <div class="field">
      <label class="label" for="<%= res %>-health">Health path <span class="opt">optional</span></label>
      <input id="<%= res %>-health" name="healthPath" placeholder="/health" />
    </div>
    <div class="field">
      <label class="label" for="<%= res %>-memory">Memory limit (MB)</label>
      <input id="<%= res %>-memory" name="memoryLimitMb" type="number" min="16" max="65536" value="<%= it.defaultMemoryMb %>" required />
    </div>
    <div class="dialog-foot">
      <button type="button" class="btn" data-close commandfor="<%= res %>" command="close">Cancel</button>
      <button type="submit" class="btn btn-primary">Create</button>
    </div>
  </form>
</dialog>

<!--
  Repository resource. The installation → repository → branch pickers are
  rendered from data the route already fetched; the Alpine component only
  filters what is already in the DOM and copies a default branch into the text
  input. It fetches nothing.
-->
<dialog id="<%= git %>" class="dialog-wide" aria-labelledby="<%= git %>-title">
  <form
    method="post"
    action="/e/<%= env.environment.id %>/resources/git"
    class="stack"
    x-data="repoPicker()"
  >
    <header class="dialog-head">
      <h2 id="<%= git %>-title">Deploy from a repository into <%= env.environment.name %></h2>
    </header>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />

    <div class="field">
      <label class="label" for="<%= git %>-name">Name</label>
      <input id="<%= git %>-name" name="name" required maxlength="60" pattern="<%= resNamePattern %>" placeholder="API [v2]" aria-describedby="<%= git %>-name-hint" />
      <p class="hint" id="<%= git %>-name-hint">Any name you like. Image tags and the automatic domain use a lowercase form of it.</p>
      <p class="error"><%= resNameError %></p>
    </div>

    <!--
      The two fields the server actually reads are hidden and written by the
      component. Everything visible below is a control over them, which is what
      lets the local-path escape hatch clear the installation and put a free
      path into the same `repo` field.
    -->
    <input type="hidden" name="installationId" :value="installationId" />
    <input type="hidden" name="repo" :value="repo" />

    <% if (!it.gitPicker.connected) { %>
    <div class="notice notice-info" role="status">
      <svg class="icon" aria-hidden="true"><use href="#i-info" /></svg>
      <div>
        No GitHub App is connected, so there are no repositories to choose from.
        Connect one under <a href="/settings">Settings</a>, install it on the
        account that owns the repository, then come back here. A public
        repository still deploys without one: type it as owner/name in the
        local-path option at the bottom of this form.
      </div>
    </div>
    <% } else { %>

    <div class="field">
      <label class="label" for="<%= git %>-account">GitHub account</label>
      <select id="<%= git %>-account" x-model="installationId" @change="onInstallationChange()">
        <option value="">Choose an account…</option>
        <% it.gitPicker.installations.forEach(function (i) { %>
        <option value="<%= i.installationId %>"><%= i.accountLogin %></option>
        <% }) %>
      </select>
    </div>

    <% it.gitPicker.installations.forEach(function (i) { %>
    <% if (i.error) { %>
    <div
      class="notice notice-error"
      role="alert"
      data-installation="<%= i.installationId %>"
      x-show="installationId === $el.dataset.installation"
      x-cloak
    >
      <svg class="icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
      <div>
        <%= i.error %> That usually means the App was uninstalled or its access
        was revoked on GitHub. Re-install it, then press Sync installations under
        Settings.
      </div>
    </div>
    <% } %>
    <% }) %>

    <div class="field" x-show="installationId !== ''" x-cloak>
      <label class="label" for="<%= git %>-filter">Filter repositories</label>
      <input
        id="<%= git %>-filter"
        type="search"
        x-model="filter"
        placeholder="Type to narrow the list"
        autocomplete="off"
      />
    </div>

    <%
      /* A radiogroup of divs rather than a list: the group role replaces the
         list's, which would leave list items without a list. A listbox is
         wrong too — its children would have to be options, not radios. The
         shared name is what makes it a group (arrow keys, one Tab stop); the
         server reads the hidden repo field and drops this one. */
    %>
    <div class="field" x-show="installationId !== ''" x-cloak>
      <span class="label" id="<%= git %>-repo-label">Repository</span>
      <div class="repo-list" role="radiogroup" aria-labelledby="<%= git %>-repo-label" x-ref="repoList">
        <% it.gitPicker.installations.forEach(function (i) { %>
        <% i.repos.forEach(function (r) { %>
        <!--
          Every attacker-influenced value travels as a data attribute, which Eta
          autoescapes, and is read back through $el. Interpolating a branch name
          into a JS string literal inside an Alpine expression would not be
          safe: HTML escaping does not escape an apostrophe for JavaScript, and
          a repository owner chooses their own branch names.
        -->
        <div
          data-installation="<%= i.installationId %>"
          data-full-name="<%= r.fullName.toLowerCase() %>"
          x-show="matchesEl($el)"
        >
          <label class="repo-option">
            <input
              type="radio"
              name="repoPick"
              x-model="repo"
              value="<%= r.fullName %>"
              data-default-branch="<%= r.defaultBranch %>"
              @change="pick($el.dataset.defaultBranch)"
            />
            <span class="mono"><%= r.fullName %></span>
            <% if (r.private) { %><span class="chip">private</span><% } %>
          </label>
        </div>
        <% }) %>
        <% }) %>
      </div>
      <p class="hint" x-show="visibleCount() === 0" x-cloak>
        No repository here matches that filter. If one is missing entirely, the
        App does not have access to it — grant it on GitHub and press Sync
        installations under Settings.
      </p>
      <% var repoTotal = it.gitPicker.installations.reduce(function (n, i) { return n + i.repos.length }, 0) %>
      <% if (repoTotal >= 200) { %>
      <p class="hint">
        All <%= repoTotal %> repositories these installations grant are listed
        here, which is why this page can take a moment to load when the list
        is read from GitHub again (at most every five minutes). If that becomes
        annoying, narrow the App's access on GitHub to the repositories you
        actually deploy.
      </p>
      <% } %>
    </div>
    <% } %>

    <div class="field">
      <label class="label" for="<%= git %>-branch">Branch</label>
      <%/* isValidGitRef (src/github/repos.ts) as a v-flag pattern: no leading
           "/", no "..", no control characters, space or ~ ^ : ? * [ \ */%>
      <input id="<%= git %>-branch" name="branch" x-model="branch" required pattern="(?!/)(?!.*\.\.)[^\x00-\x1f\x7f \~\^\:\?\*\[\\]{1,255}" placeholder="main" aria-describedby="<%= git %>-branch-hint" />
      <p class="hint" id="<%= git %>-branch-hint">Filled in from the repository's default branch when you pick one.</p>
      <p class="error">No spaces, no "..", no leading "/", and none of ~ ^ : ? * [ \</p>
    </div>

    <div class="field">
      <label class="label" for="<%= git %>-pack">Build pack</label>
      <select id="<%= git %>-pack" name="pack">
        <option value="railpack">Detect automatically (Railpack)</option>
        <option value="dockerfile">Dockerfile</option>
      </select>
    </div>

    <div class="field">
      <label class="label" for="<%= git %>-dockerfile">Dockerfile path <span class="opt">optional</span></label>
      <input id="<%= git %>-dockerfile" name="dockerfilePath" placeholder="Dockerfile" />
    </div>

    <div class="field">
      <label class="label" for="<%= git %>-context">Build context <span class="opt">optional</span></label>
      <input id="<%= git %>-context" name="buildContext" placeholder="." aria-describedby="<%= git %>-context-hint" />
      <p class="hint" id="<%= git %>-context-hint">A subdirectory to build from, for a monorepo.</p>
    </div>

    <div class="field">
      <label class="label" for="<%= git %>-port">Container port <span class="opt">optional</span></label>
      <input id="<%= git %>-port" name="containerPort" type="number" min="1" max="65535" value="3000" aria-describedby="<%= git %>-port-hint" />
      <p class="hint" id="<%= git %>-port-hint">The port the app listens on. Required to expose it over HTTPS.</p>
    </div>

    <div class="field">
      <label class="label" for="<%= git %>-health">Health path <span class="opt">optional</span></label>
      <input id="<%= git %>-health" name="healthPath" placeholder="/health" />
    </div>

    <div class="field">
      <label class="label" for="<%= git %>-memory">Memory limit (MB)</label>
      <input id="<%= git %>-memory" name="memoryLimitMb" type="number" min="16" max="65536" value="<%= it.defaultMemoryMb %>" required />
    </div>

    <details class="local-source">
      <summary>Build from a local directory instead</summary>
      <div class="field">
        <label class="label" for="<%= git %>-local">Local path</label>
        <input id="<%= git %>-local" placeholder="/srv/sources/my-app" @input="useLocal($event.target.value)" aria-describedby="<%= git %>-local-hint" />
        <p class="hint" id="<%= git %>-local-hint">
          Typing here clears the GitHub account above. An absolute path builds
          that directory on this host, for testing on the server itself. A
          public repository typed as owner/name is fetched from GitHub instead,
          without credentials.
        </p>
      </div>
    </details>

    <div class="dialog-foot">
      <button type="button" class="btn" data-close commandfor="<%= git %>" command="close">Cancel</button>
      <button type="submit" class="btn btn-primary">Create</button>
    </div>
  </form>
</dialog>
<% }) %>

<dialog id="new-env" aria-labelledby="new-env-title">
  <form method="post" action="/p/<%= it.project.id %>/environments" class="stack">
    <header class="dialog-head"><h2 id="new-env-title">New environment</h2></header>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="new-env-name">Name</label>
      <input id="new-env-name" name="name" required pattern="[a-z0-9\-]{1,32}" placeholder="staging" autofocus />
      <p class="error"><%= nameError %></p>
    </div>
    <div class="dialog-foot">
      <button type="button" class="btn" data-close commandfor="new-env" command="close">Cancel</button>
      <button type="submit" class="btn btn-primary">Create</button>
    </div>
  </form>
</dialog>
<% } %>
