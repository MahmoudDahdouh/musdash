<div class="breadcrumbs"><a href="/">Projects</a> <span>/</span> <%= it.project.name %></div>

<div class="page-head">
  <h1><%= it.project.name %></h1>
  <% if (it.tab === 'resources') { %>
  <button class="link" onclick="document.getElementById('new-env').showModal()">
    <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
    New environment
  </button>
  <% } %>
</div>

<nav class="tabs">
  <% ['resources','env'].forEach(function (t) { %>
  <a class="<%= it.tab === t ? 'active' : '' %>" href="/p/<%= it.project.id %>?tab=<%= t %>"><%= t %></a>
  <% }) %>
</nav>

<% if (it.tab === 'env') { %>
<% if (it.envError) { %><div class="flash flash-error"><%= it.envError %></div><% } %>

<div class="card stack">
  <h3>Project variables</h3>
  <p class="muted">
    Inherited by every resource in every environment of this project. An
    environment or a resource can override any of them. Reference another
    variable with <code>${OTHER}</code>, and write <code>$$</code> for a
    literal <code>$</code>.
    Currently set:
    <span class="mono"><%= it.projectEnv.length ? it.projectEnv.map(function (v) { return v.key }).join(', ') : 'none' %></span>
  </p>
  <form
    method="post"
    action="/p/<%= it.project.id %>/env"
    class="stack"
    data-confirm
    data-confirm-title="Replace this project's shared variables?"
    data-confirm-body="Saving replaces all three boxes at once — any key not in one of them is deleted from every resource that inherits it. The change takes effect on each resource's next deploy."
    data-confirm-label="Save variables"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="scope-boxes">
      <label>
        Runtime only
        <textarea name="runtime" rows="6" spellcheck="false" placeholder="LOG_LEVEL=info"></textarea>
      </label>
      <label>
        Build only
        <textarea name="build" rows="6" spellcheck="false" placeholder="NPM_TOKEN=..."></textarea>
      </label>
      <label>
        Both
        <textarea name="both" rows="6" spellcheck="false" placeholder="NODE_ENV=production"></textarea>
      </label>
    </div>
    <div class="row end">
      <button class="primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
</div>

<%
  /*
   * The id below duplicates the one on the resources tab's <section>. Safe,
   * and deliberate: the two tabs are mutually exclusive in a single render, so
   * only one is ever in the DOM, and the environment POST redirects back to
   * this fragment.
   */
%>
<% it.environments.forEach(function (env) { %>
<div class="card stack" id="env-<%= env.environment.id %>">
  <h3><%= env.environment.name %> variables</h3>
  <p class="muted">
    Inherited by the <%= env.resources.length %> resource<%= env.resources.length === 1 ? '' : 's' %>
    in this environment, overriding anything of the same name set at the
    project level.
    Currently set:
    <span class="mono"><%= env.sharedEnv.length ? env.sharedEnv.map(function (v) { return v.key }).join(', ') : 'none' %></span>
  </p>
  <form
    method="post"
    action="/e/<%= env.environment.id %>/env"
    class="stack"
    data-confirm
    data-confirm-title="Replace <%= env.environment.name %>'s variables?"
    data-confirm-body="Saving replaces all three boxes at once. Project variables and each resource's own variables are untouched."
    data-confirm-label="Save variables"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="scope-boxes">
      <label>
        Runtime only
        <textarea name="runtime" rows="6" spellcheck="false" placeholder="DATABASE_URL=postgres://..."></textarea>
      </label>
      <label>
        Build only
        <textarea name="build" rows="6" spellcheck="false"></textarea>
      </label>
      <label>
        Both
        <textarea name="both" rows="6" spellcheck="false"></textarea>
      </label>
    </div>
    <div class="row end">
      <button class="primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
</div>
<% }) %>
<% } %>

<% if (it.tab === 'resources') { %>
<% it.environments.forEach(function (env) { %>
<section class="env" id="env-<%= env.environment.id %>">
  <div class="env-head">
    <h2><%= env.environment.name %></h2>
    <div class="row gap">
      <button
        class="small"
        onclick="document.getElementById('new-git-<%= env.environment.id %>').showModal()"
      >
        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
        From repository
      </button>
      <button
        class="primary small"
        onclick="document.getElementById('new-res-<%= env.environment.id %>').showModal()"
      >
        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
        Add resource
      </button>
    </div>
  </div>

  <% if (env.resources.length === 0) { %>
  <div class="empty card small">
    <p class="muted">
      Nothing deployed here yet. Add a resource with a public Docker image such
      as <code>nginx:alpine</code>.
    </p>
  </div>
  <% } else { %>
  <div class="grid">
    <% env.resources.forEach(function (r) { %>
    <a class="card resource" href="/r/<%= r.resource.id %>">
      <div class="row between">
        <h3><%= r.resource.name %></h3>
        <span class="pill pill-<%= r.state %>" data-resource="<%= r.resource.id %>">
          <%= r.state %>
        </span>
      </div>
      <p class="muted mono"><%= r.image %></p>
      <div class="meta">
        <% if (r.domainCount > 0) { %><span><%= r.domainCount %> domain<%= r.domainCount === 1 ? '' : 's' %></span><% } %>
        <span><%= r.resource.memoryLimitMb %>MB</span>
      </div>
    </a>
    <% }) %>
  </div>
  <% } %>
</section>

<dialog id="new-res-<%= env.environment.id %>">
  <form method="post" action="/e/<%= env.environment.id %>/resources" class="stack">
    <h2>Add resource to <%= env.environment.name %></h2>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <label>
      Name
      <input name="name" required pattern="[a-z0-9-]{1,32}" placeholder="web" />
      <small class="muted">Lowercase letters, digits and dashes. Becomes a DNS label.</small>
    </label>
    <label>
      Docker image
      <input name="image" required placeholder="nginx:alpine" />
    </label>
    <label>
      Container port <small class="muted">optional</small>
      <input name="containerPort" type="number" min="1" max="65535" placeholder="80" />
      <small class="muted">The port the app listens on. Required to expose it over HTTPS.</small>
    </label>
    <label>
      Health path <small class="muted">optional</small>
      <input name="healthPath" placeholder="/health" />
    </label>
    <label>
      Memory limit (MB)
      <input name="memoryLimitMb" type="number" min="16" max="65536" value="<%= it.defaultMemoryMb %>" required />
    </label>
    <div class="row end">
      <button type="button" onclick="this.closest('dialog').close()">Cancel</button>
      <button type="submit" class="primary">Create</button>
    </div>
  </form>
</dialog>

<!--
  Repository resource. The installation → repository → branch pickers are
  rendered from data the route already fetched; the Alpine component only
  filters what is already in the DOM and copies a default branch into the text
  input. It fetches nothing.
-->
<dialog id="new-git-<%= env.environment.id %>" class="wide-dialog">
  <form
    method="post"
    action="/e/<%= env.environment.id %>/resources/git"
    class="stack"
    x-data="repoPicker()"
  >
    <h2>Deploy from a repository into <%= env.environment.name %></h2>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />

    <label>
      Name
      <input name="name" required pattern="[a-z0-9-]{1,32}" placeholder="api" />
      <small class="muted">Lowercase letters, digits and dashes. Becomes a DNS label.</small>
    </label>

    <!--
      The two fields the server actually reads are hidden and written by the
      component. Everything visible below is a control over them, which is what
      lets the local-path escape hatch clear the installation and put a free
      path into the same `repo` field.
    -->
    <input type="hidden" name="installationId" :value="installationId" />
    <input type="hidden" name="repo" :value="repo" />

    <% if (!it.gitPicker.connected) { %>
    <div class="flash flash-error">
      No GitHub App is connected, so there are no repositories to choose from.
      Connect one under <a href="/settings">Settings</a>, install it on the
      account that owns the repository, then come back here. You can still build
      from a local directory using the option at the bottom of this form.
    </div>
    <% } else { %>

    <label>
      GitHub account
      <select x-model="installationId" @change="onInstallationChange()">
        <option value="">Choose an account…</option>
        <% it.gitPicker.installations.forEach(function (i) { %>
        <option value="<%= i.installationId %>"><%= i.accountLogin %></option>
        <% }) %>
      </select>
    </label>

    <% it.gitPicker.installations.forEach(function (i) { %>
    <% if (i.error) { %>
    <div
      class="flash flash-error"
      data-installation="<%= i.installationId %>"
      x-show="installationId === $el.dataset.installation"
      x-cloak
    >
      <%= i.error %> That usually means the App was uninstalled or its access was
      revoked on GitHub. Re-install it, then press Sync installations under
      Settings.
    </div>
    <% } %>
    <% }) %>

    <label x-show="installationId !== ''" x-cloak>
      Filter repositories
      <input
        type="search"
        x-model="filter"
        placeholder="Type to narrow the list"
        autocomplete="off"
      />
    </label>

    <div class="field" x-show="installationId !== ''" x-cloak>
      <span class="field-label">Repository</span>
      <ul class="plain repo-list" role="listbox">
        <% it.gitPicker.installations.forEach(function (i) { %>
        <% i.repos.forEach(function (r) { %>
        <!--
          Every attacker-influenced value travels as a data attribute, which Eta
          autoescapes, and is read back through $el. Interpolating a branch name
          into a JS string literal inside an Alpine expression would not be
          safe: HTML escaping does not escape an apostrophe for JavaScript, and
          a repository owner chooses their own branch names.
        -->
        <li
          data-installation="<%= i.installationId %>"
          data-full-name="<%= r.fullName.toLowerCase() %>"
          x-show="matchesEl($el)"
        >
          <label class="repo-option">
            <input
              type="radio"
              x-model="repo"
              value="<%= r.fullName %>"
              data-default-branch="<%= r.defaultBranch %>"
              @change="pick($el.dataset.defaultBranch)"
            />
            <span class="mono"><%= r.fullName %></span>
            <% if (r.private) { %><span class="pill pill-stopped">private</span><% } %>
          </label>
        </li>
        <% }) %>
        <% }) %>
      </ul>
      <small class="muted" x-show="visibleCount() === 0" x-cloak>
        No repository here matches that filter. If one is missing entirely, the
        App does not have access to it — grant it on GitHub and press Sync
        installations under Settings.
      </small>
      <% var repoTotal = it.gitPicker.installations.reduce(function (n, i) { return n + i.repos.length }, 0) %>
      <% if (repoTotal >= 200) { %>
      <small class="muted">
        All <%= repoTotal %> repositories these installations grant are listed
        here, which is why this page took a moment to load. If that becomes
        annoying, narrow the App's access on GitHub to the repositories you
        actually deploy.
      </small>
      <% } %>
    </div>
    <% } %>

    <label>
      Branch
      <input name="branch" x-model="branch" required placeholder="main" />
      <small class="muted">Filled in from the repository's default branch when you pick one.</small>
    </label>

    <label>
      Build pack
      <select name="pack">
        <option value="railpack">Detect automatically (Railpack)</option>
        <option value="dockerfile">Dockerfile</option>
      </select>
    </label>

    <label>
      Dockerfile path <small class="muted">optional</small>
      <input name="dockerfilePath" placeholder="Dockerfile" />
    </label>

    <label>
      Build context <small class="muted">optional</small>
      <input name="buildContext" placeholder="." />
      <small class="muted">A subdirectory to build from, for a monorepo.</small>
    </label>

    <label>
      Container port <small class="muted">optional</small>
      <input name="containerPort" type="number" min="1" max="65535" placeholder="3000" />
      <small class="muted">The port the app listens on. Required to expose it over HTTPS.</small>
    </label>

    <label>
      Health path <small class="muted">optional</small>
      <input name="healthPath" placeholder="/health" />
    </label>

    <label>
      Memory limit (MB)
      <input name="memoryLimitMb" type="number" min="16" max="65536" value="<%= it.defaultMemoryMb %>" required />
    </label>

    <details class="local-source">
      <summary>Build from a local directory instead</summary>
      <p class="muted">
        <small>
          For testing on the server itself. Typing a path here clears the GitHub
          account above and musdash builds that directory on this host rather
          than fetching from GitHub. Give an absolute path.
        </small>
      </p>
      <label>
        Local path
        <input placeholder="/srv/sources/my-app" @input="useLocal($event.target.value)" />
      </label>
    </details>

    <div class="row end">
      <button type="button" onclick="this.closest('dialog').close()">Cancel</button>
      <button type="submit" class="primary">Create</button>
    </div>
  </form>
</dialog>
<% }) %>

<dialog id="new-env">
  <form method="post" action="/p/<%= it.project.id %>/environments" class="stack">
    <h2>New environment</h2>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <label>
      Name
      <input name="name" required pattern="[a-z0-9-]{1,32}" placeholder="staging" autofocus />
    </label>
    <div class="row end">
      <button type="button" onclick="this.closest('dialog').close()">Cancel</button>
      <button type="submit" class="primary">Create</button>
    </div>
  </form>
</dialog>
<% } %>
