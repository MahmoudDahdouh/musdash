<div class="page-head" x-data="resourceStatus('<%= it.resource.id %>', '<%= it.state %>')">
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a class="link-quiet" href="/">Projects</a></li>
      <li><a class="link-quiet" href="/p/<%= it.project.id %>"><%= it.project.name %></a></li>
      <li><a class="link-quiet" href="/p/<%= it.project.id %>#env-<%= it.environment.id %>"><%= it.environment.name %></a></li>
      <li aria-current="page"><%= it.resource.name %></li>
    </ol>
  </nav>
  <div class="page-title">
    <h1><%= it.resource.name %></h1>
    <%~ include("@status", { state: it.state, live: true }) %>
  </div>
  <div class="actions">
    <form
      method="post"
      action="/r/<%= it.resource.id %>/deploy"
      class="inline"
      data-confirm
      data-confirm-title="Deploy now?"
      data-confirm-body="Pulls the image and starts a new container. Traffic only switches once it passes the health check."
      data-confirm-label="Deploy"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-play" /></svg>
        Deploy
      </button>
    </form>
    <% if (it.resource.previousImage) { %>
    <form
      method="post"
      action="/r/<%= it.resource.id %>/rollback"
      class="inline"
      data-confirm
      data-confirm-title="Roll back to the previous image?"
      data-confirm-body="A new deploy starts from the previous image. The current one stays available to roll forward."
      data-confirm-label="Roll back"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button class="btn" type="submit" title="Roll back to <%= it.resource.previousImage %>">
        <svg class="icon" aria-hidden="true"><use href="#i-rotate-ccw" /></svg>
        Rollback
      </button>
    </form>
    <% } %>
    <% if (it.resource.desiredState === 'running') { %>
    <form
      method="post"
      action="/r/<%= it.resource.id %>/stop"
      class="inline"
      data-confirm
      data-confirm-danger
      data-confirm-title="Stop this resource?"
      data-confirm-body="The container is stopped and the site goes offline until you deploy again."
      data-confirm-label="Stop"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button class="btn" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-square" /></svg>
        Stop
      </button>
    </form>
    <% } %>
  </div>
</div>

<nav class="tabs" aria-label="Resource sections">
  <% [['overview', 'Overview'], ['logs', 'Logs'], ['env', 'Variables'], ['domains', 'Domains'], ['settings', 'Settings']].forEach(function (t) { %>
  <a href="/r/<%= it.resource.id %>?tab=<%= t[0] %>" <%~ it.tab === t[0] ? 'aria-current="page"' : '' %>><%= t[1] %></a>
  <% }) %>
</nav>

<% if (it.tab === 'overview') { %>
<div class="cols">
  <div class="card stack">
    <h2 class="card-title">Details</h2>
    <dl class="kv">
      <dt>URL</dt>
      <dd>
        <% if (it.domains.length === 0) { %>
        <span class="muted">No domain yet. Set a container port and add a domain to expose it.</span>
        <% } else { %>
        <ul class="plain">
          <% it.domains.forEach(function (d) { %>
          <li><a class="mono" href="https://<%= d.host %>" target="_blank" rel="noopener"><%= d.host %></a></li>
          <% }) %>
        </ul>
        <% } %>
      </dd>
      <dt>Image</dt>
      <% if (it.image) { %>
      <dd class="mono"><%= it.image %></dd>
      <% } else { %>
      <dd class="muted">Built on first deploy</dd>
      <% } %>
      <% if (it.resource.previousImage) { %>
      <dt>Previous image</dt>
      <dd class="mono"><%= it.resource.previousImage %></dd>
      <% } %>
      <dt>Port</dt>
      <dd class="mono"><%= it.resource.containerPort || '—' %></dd>
      <dt>Health path</dt>
      <dd class="mono"><%= it.resource.healthPath || '—' %></dd>
      <dt>Memory</dt>
      <dd><%= it.resource.memoryLimitMb %> MB</dd>
    </dl>
  </div>
  <div class="card stack">
    <h2 class="card-title">Deployments</h2>
    <% if (it.deployments.length === 0) { %>
    <p class="muted">Never deployed. Press Deploy to pull the image and start it.</p>
    <% } else { %>
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Commit</th>
            <th>Message</th>
            <th>Author</th>
            <th>Trigger</th>
            <th>Duration</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% it.deployments.forEach(function (d) { %>
          <tr>
            <td class="mono"><a href="/d/<%= d.id %>"><%= d.image %></a></td>
            <!--
              An image deploy and a rollback carry no commit metadata at all, so
              these three render an em dash rather than an empty cell — a blank
              column reads as a bug, and "null" reads as a worse one.
            -->
            <td class="mono copy"><%= d.commitSha ? d.commitSha.slice(0, 7) : '—' %></td>
            <td class="commit-message copy" title="<%= d.commitMessage || '' %>"><%= d.commitMessage ? d.commitMessage.split('\n')[0] : '—' %></td>
            <td><%= d.commitAuthor || '—' %></td>
            <td><%= d.trigger %></td>
            <td><%= d.duration %></td>
            <td><%~ include("@status", { state: d.status, live: false }) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>
<% } %>

<% if (it.tab === 'logs') { %>
<div class="card stack" x-data="logPanel('/r/<%= it.resource.id %>/logs')">
  <h2 class="card-title">Container logs</h2>
  <%/* The empty-state message sits flush against <pre>: pre-wrap would show any
       template whitespace. CSS hides it once a line arrives. */%>
  <div class="logs-wrap">
    <pre class="logs" x-ref="box" @scroll="onScroll()"><% if (it.logs.length === 0) { %><span class="logs-empty">No output yet. What the container writes to stdout and stderr appears here while it runs.</span><% } %><% it.logs.forEach(function (l) { %><span class="<%= l.stream %>"><%= l.text %></span>
<% }) %></pre>
    <button class="btn btn-sm" x-show="paused" x-cloak @click="resume()">
      <svg class="icon" aria-hidden="true"><use href="#i-arrow-down" /></svg>
      Jump to latest
    </button>
  </div>
</div>
<% } %>

<% if (it.tab === 'env') { %>
<div class="card stack">
  <h2 class="card-title">Resolved environment</h2>
  <p class="muted">
    What this resource actually gets. Project and environment variables are
    inherited; anything set here wins.
  </p>
  <% if (it.resolvedEnv.length === 0) { %>
  <p class="muted">No variables at any level yet.</p>
  <% } else { %>
  <%
    /* Where a variable is delivered, toned so the three read apart. Origin is
       not a status: the resource level is filled, inherited ones outlined. */
    var scopeTone = { runtime: 'busy', build: 'warn', both: 'ok' }
  %>
  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr><th>Key</th><th>Delivered to</th><th>From</th><th>Overrides</th></tr>
      </thead>
      <tbody>
        <% it.resolvedEnv.forEach(function (v) { %>
        <tr>
          <td class="mono"><%= v.key %></td>
          <td><span class="chip chip-<%= scopeTone[v.scope] %>"><%= v.scope %></span></td>
          <td><span class="<%= v.origin === 'resource' ? 'chip' : 'chip chip-outline' %>"><%= v.origin %></span></td>
          <!-- An em dash rather than an empty cell: a blank reads as a bug. -->
          <td class="muted"><%= v.overrides.length ? v.overrides.join(', ') : '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="muted">
    Project and environment variables are edited on the
    <a href="/p/<%= it.project.id %>?tab=env">project's Variables tab</a>.
  </p>
  <% } %>
</div>

<div class="card stack">
  <h2 class="card-title">Resource variables</h2>
  <p class="muted">
    One <code>KEY=value</code> per line, in the box for where it is needed.
    Runtime variables reach the container; build variables reach the build and
    are baked into the image. Reference another variable with
    <code>${OTHER}</code>, and write <code>$$</code> for a literal
    <code>$</code>. Values are encrypted at rest and never shown again after
    saving.
  </p>
  <form
    method="post"
    action="/r/<%= it.resource.id %>/env"
    class="stack"
    data-confirm
    data-confirm-title="Replace this resource's variables?"
    data-confirm-body="Saving replaces all three boxes at once — any key not in one of them is deleted. Inherited project and environment variables are untouched. The change takes effect on the next deploy."
    data-confirm-label="Save variables"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="scope-boxes">
      <div class="field">
        <label class="label" for="res-vars-runtime">Runtime only</label>
        <textarea id="res-vars-runtime" name="runtime" rows="8" spellcheck="false" placeholder="DATABASE_URL=postgres://..."></textarea>
      </div>
      <div class="field">
        <label class="label" for="res-vars-build">Build only</label>
        <textarea id="res-vars-build" name="build" rows="8" spellcheck="false" placeholder="NPM_TOKEN=..."></textarea>
      </div>
      <div class="field">
        <label class="label" for="res-vars-both">Both</label>
        <textarea id="res-vars-both" name="both" rows="8" spellcheck="false" placeholder="NODE_ENV=production"></textarea>
      </div>
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save variables
      </button>
    </div>
  </form>
</div>
<% } %>

<% if (it.tab === 'domains') { %>
<div class="card stack">
  <h2 class="card-title">Domains</h2>
  <% if (it.autoDomain) { %>
  <p class="muted">Automatic: <span class="mono"><%= it.autoDomain %></span></p>
  <% } else { %>
  <p class="muted">
    No wildcard domain configured, so there is no automatic subdomain. Set
    <code>MUSDASH_WILDCARD_DOMAIN</code> to enable it.
  </p>
  <% } %>
  <ul class="plain">
    <% it.domains.forEach(function (d) { %>
    <li class="row between">
      <span class="mono"><%= d.host %><%= d.isAuto ? ' (auto)' : '' %></span>
      <form
        method="post"
        action="/r/<%= it.resource.id %>/domains/<%= d.id %>/delete"
        class="inline"
        data-confirm
        data-confirm-danger
        data-confirm-title="Remove this domain?"
        data-confirm-body="Traffic to this hostname will stop being routed here as soon as the change applies."
        data-confirm-label="Remove domain"
      >
        <input type="hidden" name="csrf" value="<%= it.csrf %>" />
        <button class="btn btn-danger btn-sm" type="submit">
          <svg class="icon" aria-hidden="true"><use href="#i-x" /></svg>
          Remove
        </button>
      </form>
    </li>
    <% }) %>
  </ul>
  <form method="post" action="/r/<%= it.resource.id %>/domains" class="stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="res-domain">Custom domain</label>
      <div class="row gap">
        <%/* HOSTNAME_RE (src/caddy/client.ts) plus its 253 limit, with capitals
             allowed because the server lowercases before checking. */%>
        <input id="res-domain" name="host" placeholder="app.example.com" required pattern="(?=.{1,253}$)[a-zA-Z0-9]([a-zA-Z0-9\-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]*[a-zA-Z0-9])?)+" autocapitalize="none" spellcheck="false" aria-describedby="res-domain-hint" />
        <button class="btn" type="submit">
          <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
          Add domain
        </button>
      </div>
      <p class="hint" id="res-domain-hint">An A or AAAA record for it must point at this server. Its first certificate takes a few seconds to a minute after the name is added or deployed.</p>
      <p class="error">Enter a bare hostname such as app.example.com, without https:// or a path.</p>
    </div>
  </form>
</div>
<% } %>

<% if (it.tab === 'settings') { %>
<% if (it.resource.kind === 'git') { %>
<div class="card stack">
  <h2 class="card-title">Source</h2>
  <dl class="kv">
    <dt>Repository</dt>
    <dd class="mono"><%= it.resource.gitRepo || '—' %></dd>
    <dt>Branch</dt>
    <dd class="mono"><%= it.resource.gitBranch || '—' %></dd>
    <dt>Build pack</dt>
    <dd><%= it.resource.buildPack === 'dockerfile' ? 'Dockerfile' : 'Detected automatically (Railpack)' %></dd>
  </dl>

  <!--
    An unchecked checkbox submits nothing at all, which is exactly how "off" is
    expressed here — the handler reads an absent `enabled` as off. The page
    reloads from the database after Save, so what is drawn is what is stored.
  -->
  <form
    method="post"
    action="/r/<%= it.resource.id %>/auto-deploy"
    class="stack"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="checkline">
        <input type="checkbox" name="enabled" value="on" aria-describedby="res-auto-hint" <%= it.resource.autoDeploy ? 'checked' : '' %> />
        Deploy automatically when someone pushes to
        <span class="mono"><%= it.resource.gitBranch || 'the tracked branch' %></span>
      </label>
      <p class="hint" id="res-auto-hint">
        Requires the GitHub App's webhook to reach this instance. A push to any
        other branch is ignored.
      </p>
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
</div>
<% } %>

<div class="card stack">
  <h2 class="card-title">Settings</h2>
  <form method="post" action="/r/<%= it.resource.id %>/settings" class="stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <% if (it.resource.kind === 'git') { %>
    <!--
      A git resource builds its own image, so there is nothing to type here and
      the handler ignores the field for this kind. It stays present but hidden
      because the body schema requires it; making it a visible `required` input
      would block the form outright before the first build has produced a tag.
    -->
    <input type="hidden" name="image" value="" />
    <p class="muted">
      The image is produced by each build from
      <span class="mono"><%= it.resource.gitRepo || 'the source' %></span>, so
      there is nothing to set here.
    </p>
    <% } else { %>
    <div class="field">
      <label class="label" for="res-image">Docker image</label>
      <input id="res-image" name="image" value="<%= it.image %>" required />
    </div>
    <% } %>
    <div class="field">
      <label class="label" for="res-port">Container port <span class="opt">optional</span></label>
      <input id="res-port" name="containerPort" type="number" min="1" max="65535" value="<%= it.resource.containerPort || '' %>" />
    </div>
    <div class="field">
      <label class="label" for="res-health">Health path <span class="opt">optional</span></label>
      <input id="res-health" name="healthPath" value="<%= it.resource.healthPath || '' %>" />
    </div>
    <div class="field">
      <label class="label" for="res-memory">Memory limit (MB)</label>
      <input id="res-memory" name="memoryLimitMb" type="number" min="16" max="65536" value="<%= it.resource.memoryLimitMb %>" required aria-describedby="res-memory-hint" />
      <p class="hint" id="res-memory-hint">Every container has a limit. There is no unlimited option.</p>
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
</div>

<div class="card card-danger stack">
  <h2 class="card-title">Delete resource</h2>
  <p class="muted">
    Stops and removes the container, its route and its volumes. This cannot be
    undone.
  </p>
  <form
    method="post"
    action="/r/<%= it.resource.id %>/delete"
    data-confirm
    data-confirm-danger
    data-confirm-title="Delete this resource?"
    data-confirm-body="The container, its route, its volumes and its deployment history are removed. This cannot be undone."
    data-confirm-label="Delete resource"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <button class="btn btn-danger" type="submit">
      <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
      Delete this resource
    </button>
  </form>
</div>
<% } %>
