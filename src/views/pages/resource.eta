<div class="breadcrumbs">
  <a href="/">Projects</a> <span>/</span>
  <a href="/p/<%= it.project.id %>"><%= it.project.name %></a> <span>/</span>
  <%= it.environment.name %> <span>/</span> <%= it.resource.name %>
</div>

<div class="page-head" x-data="statusPill('<%= it.resource.id %>', '<%= it.state %>')">
  <div class="row gap">
    <h1><%= it.resource.name %></h1>
    <span class="pill" :class="'pill-' + state" x-text="state"></span>
  </div>
  <div class="row gap">
    <form
      method="post"
      action="/r/<%= it.resource.id %>/deploy"
      class="inline"
      data-confirm
      data-confirm-title="Deploy now?"
      data-confirm-body="Pulls the image and starts a new container. Traffic only switches once it passes the health check."
      data-confirm-label="Deploy"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button class="primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-play" /></svg>
        Deploy
      </button>
    </form>
    <% if (it.resource.previousImage) { %>
    <form
      method="post"
      action="/r/<%= it.resource.id %>/rollback"
      class="inline"
      data-confirm
      data-confirm-title="Roll back to the previous image?"
      data-confirm-body="A new deploy starts from the previous image. The current one stays available to roll forward."
      data-confirm-label="Roll back"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button type="submit" title="Roll back to <%= it.resource.previousImage %>">
        <svg class="icon" aria-hidden="true"><use href="#i-rotate-ccw" /></svg>
        Rollback
      </button>
    </form>
    <% } %>
    <% if (it.resource.desiredState === 'running') { %>
    <form
      method="post"
      action="/r/<%= it.resource.id %>/stop"
      class="inline"
      data-confirm
      data-confirm-danger
      data-confirm-title="Stop this resource?"
      data-confirm-body="The container is stopped and the site goes offline until you deploy again."
      data-confirm-label="Stop"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-square" /></svg>
        Stop
      </button>
    </form>
    <% } %>
  </div>
</div>

<nav class="tabs">
  <% ['overview','logs','env','domains','settings'].forEach(function (t) { %>
  <a class="<%= it.tab === t ? 'active' : '' %>" href="/r/<%= it.resource.id %>?tab=<%= t %>"><%= t %></a>
  <% }) %>
</nav>

<% if (it.tab === 'overview') { %>
<div class="cols">
  <div class="card stack">
    <h3>Image</h3>
    <p class="mono"><%= it.image %></p>
    <% if (it.resource.previousImage) { %>
    <p class="muted">Previous: <span class="mono"><%= it.resource.previousImage %></span></p>
    <% } %>
    <h3>URL</h3>
    <% if (it.domains.length === 0) { %>
    <p class="muted">No domain yet. Set a container port and add a domain to expose it.</p>
    <% } else { %>
    <ul class="plain">
      <% it.domains.forEach(function (d) { %>
      <li><a href="https://<%= d.host %>" target="_blank" rel="noopener"><%= d.host %></a></li>
      <% }) %>
    </ul>
    <% } %>
  </div>
  <div class="card stack">
    <h3>Deployments</h3>
    <% if (it.deployments.length === 0) { %>
    <p class="muted">Never deployed. Press Deploy to pull the image and start it.</p>
    <% } else { %>
    <table class="deployments">
      <thead>
        <tr>
          <th>Image</th>
          <th>Commit</th>
          <th>Message</th>
          <th>Author</th>
          <th>Trigger</th>
          <th>Duration</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% it.deployments.forEach(function (d) { %>
        <tr>
          <td class="mono"><a href="/d/<%= d.id %>"><%= d.image %></a></td>
          <!--
            An image deploy and a rollback carry no commit metadata at all, so
            these three render an em dash rather than an empty cell — a blank
            column reads as a bug, and "null" reads as a worse one.
          -->
          <td class="mono"><%= d.commitSha ? d.commitSha.slice(0, 7) : '—' %></td>
          <td class="commit-message" title="<%= d.commitMessage || '' %>"><%= d.commitMessage ? d.commitMessage.split('\n')[0] : '—' %></td>
          <td><%= d.commitAuthor || '—' %></td>
          <td><%= d.trigger %></td>
          <td><%= d.duration %></td>
          <td><span class="pill pill-<%= d.pill %>"><%= d.status %></span></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>
<% } %>

<% if (it.tab === 'logs') { %>
<div class="card" x-data="logPanel('/r/<%= it.resource.id %>/logs')">
  <div class="row between">
    <h3>Container logs</h3>
    <button class="link" x-show="paused" x-cloak @click="resume()">
      <svg class="icon" aria-hidden="true"><use href="#i-arrow-down" /></svg>
      Jump to latest
    </button>
  </div>
  <pre class="logs" x-ref="box" @scroll="onScroll()"><% it.logs.forEach(function (l) { %><span class="<%= l.stream %>"><%= l.text %></span>
<% }) %></pre>
</div>
<% } %>

<% if (it.tab === 'env') { %>
<div class="card stack">
  <h3>Resolved environment</h3>
  <p class="muted">
    What this resource actually gets. Project and environment variables are
    inherited; anything set here wins.
  </p>
  <% if (it.resolvedEnv.length === 0) { %>
  <p class="muted">No variables at any level yet.</p>
  <% } else { %>
  <div class="table-scroll">
    <table class="env-table">
      <thead>
        <tr><th>Key</th><th>Delivered to</th><th>From</th><th>Overrides</th></tr>
      </thead>
      <tbody>
        <% it.resolvedEnv.forEach(function (v) { %>
        <tr>
          <td class="mono"><%= v.key %></td>
          <td><span class="pill pill-<%= v.scope %>"><%= v.scope %></span></td>
          <td><span class="origin origin-<%= v.origin %>"><%= v.origin %></span></td>
          <!-- An em dash rather than an empty cell: a blank reads as a bug. -->
          <td class="muted"><%= v.overrides.length ? v.overrides.join(', ') : '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="muted">
    Project and environment variables are edited on the
    <a href="/p/<%= it.project.id %>?tab=env">project's env tab</a>.
  </p>
  <% } %>
</div>

<div class="card stack">
  <h3>Resource variables</h3>
  <p class="muted">
    One <code>KEY=value</code> per line, in the box for where it is needed.
    Runtime variables reach the container; build variables reach the build and
    are baked into the image. Reference another variable with
    <code>${OTHER}</code>, and write <code>$$</code> for a literal
    <code>$</code>. Values are encrypted at rest and never shown again after
    saving.
  </p>
  <% if (it.envError) { %><div class="flash flash-error"><%= it.envError %></div><% } %>
  <form
    method="post"
    action="/r/<%= it.resource.id %>/env"
    class="stack"
    data-confirm
    data-confirm-title="Replace this resource's variables?"
    data-confirm-body="Saving replaces all three boxes at once — any key not in one of them is deleted. Inherited project and environment variables are untouched. The change takes effect on the next deploy."
    data-confirm-label="Save variables"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="scope-boxes">
      <label>
        Runtime only
        <textarea name="runtime" rows="8" spellcheck="false" placeholder="DATABASE_URL=postgres://..."></textarea>
      </label>
      <label>
        Build only
        <textarea name="build" rows="8" spellcheck="false" placeholder="NPM_TOKEN=..."></textarea>
      </label>
      <label>
        Both
        <textarea name="both" rows="8" spellcheck="false" placeholder="NODE_ENV=production"></textarea>
      </label>
    </div>
    <div class="row end">
      <button class="primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
</div>
<% } %>

<% if (it.tab === 'domains') { %>
<div class="card stack">
  <h3>Domains</h3>
  <% if (it.autoDomain) { %>
  <p class="muted">Automatic: <span class="mono"><%= it.autoDomain %></span></p>
  <% } else { %>
  <p class="muted">
    No wildcard domain configured, so there is no automatic subdomain. Set
    <code>MUSDASH_WILDCARD_DOMAIN</code> to enable it.
  </p>
  <% } %>
  <ul class="plain">
    <% it.domains.forEach(function (d) { %>
    <li class="row between">
      <span class="mono"><%= d.host %><%= d.isAuto ? ' (auto)' : '' %></span>
      <form
        method="post"
        action="/r/<%= it.resource.id %>/domains/<%= d.id %>/delete"
        class="inline"
        data-confirm
        data-confirm-danger
        data-confirm-title="Remove this domain?"
        data-confirm-body="Traffic to this hostname will stop being routed here as soon as the change applies."
        data-confirm-label="Remove domain"
      >
        <input type="hidden" name="csrf" value="<%= it.csrf %>" />
        <button class="link danger" type="submit">
          <svg class="icon" aria-hidden="true"><use href="#i-x" /></svg>
          Remove
        </button>
      </form>
    </li>
    <% }) %>
  </ul>
  <form method="post" action="/r/<%= it.resource.id %>/domains" class="row gap">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <input name="host" placeholder="app.example.com" required />
    <button type="submit">
      <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
      Add domain
    </button>
  </form>
</div>
<% } %>

<% if (it.tab === 'settings') { %>
<% if (it.resource.kind === 'git') { %>
<div class="card stack">
  <h3>Source</h3>
  <dl class="kv">
    <dt>Repository</dt>
    <dd class="mono"><%= it.resource.gitRepo || '—' %></dd>
    <dt>Branch</dt>
    <dd class="mono"><%= it.resource.gitBranch || '—' %></dd>
    <dt>Build pack</dt>
    <dd><%= it.resource.buildPack === 'dockerfile' ? 'Dockerfile' : 'Detected automatically (Railpack)' %></dd>
  </dl>

  <!--
    An unchecked checkbox submits nothing at all, which is exactly how "off" is
    expressed here — the handler reads an absent `enabled` as off. Submitting on
    change rather than behind a Save button keeps the control honest: what is
    drawn is what is stored, because the page reloads from the database.
  -->
  <form
    method="post"
    action="/r/<%= it.resource.id %>/auto-deploy"
    class="stack"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <label class="checkline">
      <input type="checkbox" name="enabled" value="on" <%= it.resource.autoDeploy ? 'checked' : '' %> />
      Deploy automatically when someone pushes to
      <span class="mono"><%= it.resource.gitBranch || 'the tracked branch' %></span>
    </label>
    <small class="muted">
      Requires the GitHub App's webhook to reach this instance. A push to any
      other branch is ignored.
    </small>
    <div class="row end">
      <button class="primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
</div>
<% } %>

<div class="card stack">
  <h3>Settings</h3>
  <form method="post" action="/r/<%= it.resource.id %>/settings" class="stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <% if (it.resource.kind === 'git') { %>
    <!--
      A git resource builds its own image, so there is nothing to type here and
      the handler ignores the field for this kind. It stays present but hidden
      because the body schema requires it; making it a visible `required` input
      would block the form outright before the first build has produced a tag.
    -->
    <input type="hidden" name="image" value="" />
    <p class="muted">
      The image is produced by each build from
      <span class="mono"><%= it.resource.gitRepo || 'the source' %></span>, so
      there is nothing to set here.
    </p>
    <% } else { %>
    <label>Docker image<input name="image" value="<%= it.image %>" required /></label>
    <% } %>
    <label>
      Container port
      <input name="containerPort" type="number" min="1" max="65535" value="<%= it.resource.containerPort || '' %>" />
    </label>
    <label>Health path<input name="healthPath" value="<%= it.resource.healthPath || '' %>" /></label>
    <label>
      Memory limit (MB)
      <input name="memoryLimitMb" type="number" min="16" max="65536" value="<%= it.resource.memoryLimitMb %>" required />
      <small class="muted">Every container has a limit. There is no unlimited option.</small>
    </label>
    <div class="row end">
      <button class="primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
</div>

<div class="card stack danger-zone">
  <h3>Delete resource</h3>
  <p class="muted">
    Stops and removes the container, its route and its volumes. This cannot be
    undone.
  </p>
  <form
    method="post"
    action="/r/<%= it.resource.id %>/delete"
    data-confirm
    data-confirm-danger
    data-confirm-title="Delete this resource?"
    data-confirm-body="The container, its route, its volumes and its deployment history are removed. This cannot be undone."
    data-confirm-label="Delete resource"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <button class="danger" type="submit">
      <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
      Delete this resource
    </button>
  </form>
</div>
<% } %>
