<%
  /* A Compose stack shares this page with image and git resources; its
     branches sit beside theirs. `it.compose` is undefined only when the
     stack's saved source cannot be read, so every use of `cs` checks it.
     A stack is routed by its public service and port — never containerPort,
     which a stack does not have. */
  var isCompose = it.resource.kind === 'compose'
  var cs = it.compose ? it.compose.source : null
  var routed = !!(cs && cs.publicService && cs.publicPort)
%>
<div class="page-head" x-data="resourceStatus('<%= it.resource.id %>', '<%= it.state %>')">
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a class="link-quiet" href="/">Projects</a></li>
      <li><a class="link-quiet" href="/p/<%= it.project.id %>"><%= it.project.name %></a></li>
      <li><a class="link-quiet" href="/p/<%= it.project.id %>#env-<%= it.environment.id %>"><%= it.environment.name %></a></li>
      <li aria-current="page"><%= it.resource.name %></li>
    </ol>
  </nav>
  <div class="page-title">
    <h1><%= it.resource.name %></h1>
    <%~ include("@status", { state: it.state, live: true }) %>
  </div>
  <div class="actions">
    <form
      method="post"
      action="/r/<%= it.resource.id %>/deploy"
      class="inline"
      data-confirm
      data-confirm-title="Deploy now?"
      <% if (isCompose) { %>
      data-confirm-body="Deploys the Compose file saved in Settings with the current variables. Services whose configuration changed are recreated in place, so they may be briefly unavailable."
      <% } else { %>
      data-confirm-body="<%= it.resource.kind === 'git' ? 'Builds the latest commit on the branch' : 'Pulls the image' %> and starts a new container. Traffic only switches once it passes the health check."
      <% } %>
      data-confirm-label="Deploy"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-play" /></svg>
        Deploy
      </button>
    </form>
    <% if (it.resource.previousImage) { %>
    <form
      method="post"
      action="/r/<%= it.resource.id %>/rollback"
      class="inline"
      data-confirm
      data-confirm-title="Roll back to the previous image?"
      data-confirm-body="A new deploy starts from the previous image. The current one stays available to roll forward."
      data-confirm-label="Roll back"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button class="btn" type="submit" title="Roll back to <%= it.resource.previousImage %>">
        <svg class="icon" aria-hidden="true"><use href="#i-rotate-ccw" /></svg>
        Rollback
      </button>
    </form>
    <% } %>
    <% if (it.resource.desiredState === 'running') { %>
    <form
      method="post"
      action="/r/<%= it.resource.id %>/stop"
      class="inline"
      data-confirm
      data-confirm-danger
      data-confirm-title="Stop this resource?"
      <% if (isCompose) { %>
      data-confirm-body="Every service in the stack is stopped, and its domains go offline until you deploy again."
      <% } else { %>
      data-confirm-body="The container is stopped and the site goes offline until you deploy again."
      <% } %>
      data-confirm-label="Stop"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button class="btn" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-square" /></svg>
        Stop
      </button>
    </form>
    <% } %>
  </div>
</div>

<nav class="tabs" aria-label="Resource sections">
  <% [['overview', 'Overview'], ['logs', 'Logs'], ['env', 'Variables'], ['domains', 'Domains'], ['settings', 'Settings']].forEach(function (t) { %>
  <a href="/r/<%= it.resource.id %>?tab=<%= t[0] %>" <%~ it.tab === t[0] ? 'aria-current="page"' : '' %>><%= t[1] %></a>
  <% }) %>
</nav>

<% if (it.tab === 'overview') { %>
<% if (isCompose) { %>
<div class="card stack stack-services">
  <h2 class="card-title">Services</h2>
  <% if (!cs || !it.compose.services) { %>
  <p class="muted">This stack's saved settings could not be read, so its services cannot be listed.</p>
  <% } else if (it.compose.services.length === 0) { %>
  <p class="muted">No services recorded yet. They are listed once the Compose file has been read.</p>
  <% } else { %>
  <% if (!it.compose.containersKnown) { %>
  <p class="muted">The service states could not be read from Docker just now. Reload the page to try again.</p>
  <% } %>
  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <th>Service</th>
          <th>Image</th>
          <th>State</th>
          <th>Memory limit</th>
          <th>Routed host</th>
        </tr>
      </thead>
      <tbody>
        <% it.compose.services.forEach(function (s) {
          /* Chips, never @status: that maps a running DEPLOYMENT to
             "Deploying", and here running means the container is up. When
             the list could not be read no state is claimed at all. */
          var chip
          if (!it.compose.containersKnown) chip = ['chip chip-outline', 'Unknown']
          else if (s.state === 'running') chip = ['chip chip-ok', 'Running']
          else if (s.state === 'restarting') chip = ['chip chip-warn', 'Restarting']
          else if (s.state === 'created') chip = ['chip chip-busy', 'Created']
          else if (s.state === 'exited' && s.exitCode === 0) chip = ['chip', 'Exited (0)']
          else if (s.state === 'exited') chip = ['chip chip-warn', s.exitCode === null ? 'Exited' : 'Exited (' + s.exitCode + ')']
          else chip = ['chip chip-outline', 'No container']
        %>
        <tr>
          <td class="mono"><%= s.name %></td>
          <td class="mono"><%= s.image || '—' %></td>
          <td><span class="<%= chip[0] %>"><%= chip[1] %></span></td>
          <td><%= s.memoryMb ? s.memoryMb + ' MB' : '—' %></td>
          <% if (s.routedHost) { %>
          <td><a class="mono" href="https://<%= s.routedHost %>" target="_blank" rel="noopener"><%= s.routedHost %></a></td>
          <% } else { %>
          <td class="muted">—</td>
          <% } %>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<% } %>
<div class="cols">
  <div class="card stack">
    <h2 class="card-title">Details</h2>
    <dl class="kv">
      <dt>URL</dt>
      <dd>
        <% if (isCompose) { %>
        <% if (it.domains.length === 0 && routed) { %>
        <span class="muted">No domain yet. Add one on the <a href="?tab=domains">Domains</a> tab.</span>
        <% } else if (it.domains.length === 0) { %>
        <span class="muted">No domain yet. Name a public service and its port in Settings to give the stack an address.</span>
        <% } else { %>
        <%/* Linked only when the routing plan sends the host somewhere: a
             row on a service, or one following a public service that is set.
             Anything else (no public service, a refused second port) gets no
             route, so it is listed, not linked. */
          var planned = (it.compose && it.compose.routedHosts) || []
          var unrouted = it.domains.filter(function (d) { return planned.indexOf(d.host.toLowerCase()) === -1 })
        %>
        <ul class="plain">
          <% it.domains.forEach(function (d) { %>
          <% if (planned.indexOf(d.host.toLowerCase()) !== -1) { %>
          <li><a class="mono" href="https://<%= d.host %>" target="_blank" rel="noopener"><%= d.host %></a></li>
          <% } else { %>
          <li class="mono"><%= d.host %></li>
          <% } %>
          <% }) %>
        </ul>
        <% if (unrouted.length > 0) { %>
        <p class="muted">
          <%= unrouted.length === it.domains.length ? 'Not routed.' : 'Unlinked hosts are not routed.' %>
          <% if (!routed) { %>
          A domain with no service follows the public service, and this stack has none.
          <a href="/r/<%= it.resource.id %>?tab=settings">Set one in Settings</a>, then deploy.
          <% } else { %>
          See the <a href="/r/<%= it.resource.id %>?tab=domains">Domains</a> tab.
          <% } %>
        </p>
        <% } %>
        <% } %>
        <% } else if (it.domains.length === 0) { %>
        <span class="muted">No domain yet. Set a container port and add a domain to expose it.</span>
        <% } else if (!it.resource.containerPort) { %>
        <%/* A deploy with no port writes no route (L-3), so these hosts do not
             reach the app: listed, not linked. */%>
        <ul class="plain">
          <% it.domains.forEach(function (d) { %>
          <li class="mono"><%= d.host %></li>
          <% }) %>
        </ul>
        <p class="muted">
          Not routed: this resource has no container port.
          <a href="/r/<%= it.resource.id %>?tab=settings">Set one in Settings</a>, then deploy.
        </p>
        <% } else { %>
        <ul class="plain">
          <% it.domains.forEach(function (d) { %>
          <li><a class="mono" href="https://<%= d.host %>" target="_blank" rel="noopener"><%= d.host %></a></li>
          <% }) %>
        </ul>
        <% } %>
      </dd>
      <% if (isCompose) { %>
      <dt>Public service</dt>
      <% if (routed) { %>
      <dd class="mono"><%= cs.publicService %>:<%= cs.publicPort %></dd>
      <% } else { %>
      <dd class="muted">None</dd>
      <% } %>
      <dt>Health path</dt>
      <dd class="mono"><%= it.resource.healthPath || '—' %></dd>
      <dt>Memory, all services</dt>
      <dd><%= it.resource.memoryLimitMb ? it.resource.memoryLimitMb + ' MB' : '—' %></dd>
      <% } else { %>
      <dt>Image</dt>
      <% if (it.image) { %>
      <dd class="mono"><%= it.image %></dd>
      <% } else { %>
      <dd class="muted">Built on first deploy</dd>
      <% } %>
      <% if (it.resource.previousImage) { %>
      <dt>Previous image</dt>
      <dd class="mono"><%= it.resource.previousImage %></dd>
      <% } %>
      <dt>Port</dt>
      <dd class="mono"><%= it.resource.containerPort || '—' %></dd>
      <dt>Health path</dt>
      <dd class="mono"><%= it.resource.healthPath || '—' %></dd>
      <dt>Memory</dt>
      <dd><%= it.resource.memoryLimitMb %> MB</dd>
      <% } %>
    </dl>
  </div>
  <div class="card stack">
    <h2 class="card-title">Deployments</h2>
    <% if (it.deployments.length === 0 && isCompose) { %>
    <p class="muted">Never deployed. Press Deploy to pull the stack's images and start it.</p>
    <% } else if (it.deployments.length === 0) { %>
    <p class="muted">Never deployed. Press Deploy to <%= it.resource.kind === 'git' ? 'build the latest commit on the branch' : 'pull the image' %> and start it.</p>
    <% } else if (isCompose) { %>
    <%/* A stack's row names the file it deployed (@deploy-image reads the
         descriptor as "Compose file <hash>"); it has no commit to show. */%>
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>File</th>
            <th>Trigger</th>
            <th>Duration</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% it.deployments.forEach(function (d) { %>
          <tr>
            <td class="mono"><a href="/d/<%= d.id %>"><%~ include("@deploy-image", { pending: d.imagePending, status: d.status, image: d.image }) %></a></td>
            <td><%= d.trigger %></td>
            <td><%= d.duration %></td>
            <td><%~ include("@status", { state: d.status, live: false }) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Commit</th>
            <th>Message</th>
            <th>Author</th>
            <th>Trigger</th>
            <th>Duration</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% it.deployments.forEach(function (d) { %>
          <tr>
            <td class="mono"><a href="/d/<%= d.id %>"><%~ include("@deploy-image", { pending: d.imagePending, status: d.status, image: d.image }) %></a></td>
            <!--
              An image deploy and a rollback carry no commit metadata at all, so
              these three render an em dash rather than an empty cell — a blank
              column reads as a bug, and "null" reads as a worse one.
            -->
            <td class="mono copy"><%= d.commitSha ? d.commitSha.slice(0, 7) : '—' %></td>
            <td class="commit-message copy" title="<%= d.commitMessage || '' %>"><%= d.commitMessage ? d.commitMessage.split('\n')[0] : '—' %></td>
            <td><%= d.commitAuthor || '—' %></td>
            <td><%= d.trigger %></td>
            <td><%= d.duration %></td>
            <td><%~ include("@status", { state: d.status, live: false }) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>
<% } %>

<% if (it.tab === 'logs') { %>
<div class="card stack" x-data="logPanel('/r/<%= it.resource.id %>/logs')">
  <% if (isCompose) { %>
  <h2 class="card-title">Service logs</h2>
  <p class="muted">Every service of the stack in one stream. Each line starts with the service it came from, such as <span class="mono">[web]</span>.</p>
  <% } else { %>
  <h2 class="card-title">Container logs</h2>
  <% } %>
  <%/* The empty-state message sits flush against <pre>: pre-wrap would show any
       template whitespace. CSS hides it once a line arrives. */%>
  <div class="logs-wrap">
    <pre class="logs" x-ref="box" @scroll="onScroll()"><% if (it.logs.length === 0 && isCompose) { %><span class="logs-empty">No output yet. What the stack's services write to stdout and stderr appears here while they run, each line prefixed with its [service] name.</span><% } else if (it.logs.length === 0) { %><span class="logs-empty">No output yet. What the container writes to stdout and stderr appears here while it runs.</span><% } %><% it.logs.forEach(function (l) { %><span class="<%= l.stream %>"><%= l.text %></span>
<% }) %></pre>
    <button class="btn btn-sm" x-show="paused" x-cloak @click="resume()">
      <svg class="icon" aria-hidden="true"><use href="#i-arrow-down" /></svg>
      Jump to latest
    </button>
  </div>
</div>
<% } %>

<% if (it.tab === 'env') { %>
<div class="card stack">
  <h2 class="card-title">Resolved environment</h2>
  <% if (isCompose) { %>
  <p class="muted">
    What the Compose file can use. Project and environment variables are
    inherited; anything set here wins. A stack reads runtime variables only,
    so build-only ones are marked as not used.
  </p>
  <% } else { %>
  <p class="muted">
    What this resource actually gets. Project and environment variables are
    inherited; anything set here wins.
  </p>
  <% } %>
  <% if (it.resolvedEnv.length === 0) { %>
  <p class="muted">No variables at any level yet.</p>
  <% } else { %>
  <%
    /* Where a variable is delivered, toned so the three read apart. Origin is
       not a status: the resource level is filled, inherited ones outlined. */
    var scopeTone = { runtime: 'busy', build: 'warn', both: 'ok' }
  %>
  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr><th>Key</th><th>Delivered to</th><th>From</th><th>Overrides</th></tr>
      </thead>
      <tbody>
        <% it.resolvedEnv.forEach(function (v) { %>
        <tr>
          <td class="mono"><%= v.key %></td>
          <% if (isCompose && v.scope === 'build') { %>
          <%/* A deploy interpolates the file with runtime and both only. */%>
          <td><span class="chip chip-<%= scopeTone[v.scope] %>"><%= v.scope %></span> <span class="muted">not used by stacks</span></td>
          <% } else { %>
          <td><span class="chip chip-<%= scopeTone[v.scope] %>"><%= v.scope %></span></td>
          <% } %>
          <td><span class="<%= v.origin === 'resource' ? 'chip' : 'chip chip-outline' %>"><%= v.origin %></span></td>
          <!-- An em dash rather than an empty cell: a blank reads as a bug. -->
          <td class="muted"><%= v.overrides.length ? v.overrides.join(', ') : '—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="muted">
    Project and environment variables are edited on the
    <a href="/p/<%= it.project.id %>?tab=env">project's Variables tab</a>.
  </p>
  <% } %>
</div>

<% if (isCompose) { %>
<div class="card stack">
  <h2 class="card-title">Resource variables</h2>
  <p class="muted">
    One <code>KEY=value</code> per line. Each is available to the Compose file
    as <code>${NAME}</code>; a service gets a variable only where the file
    passes it, for example under <code>environment:</code>. A reference with
    no value and no default fails the deploy. Reference another variable with
    <code>${OTHER}</code>, and write <code>$$</code> for a literal
    <code>$</code>. Values are encrypted at rest and shown only here. The box
    shows what is saved, and saving replaces it with what it holds.
  </p>
  <%/* One box, posted as `runtime`: a stack has no build, and the route fills
       it with the resource's variables of every scope, so saving it unchanged
       keeps every key (as runtime) rather than deleting the others. */%>
  <form
    method="post"
    action="/r/<%= it.resource.id %>/env"
    class="stack"
    autocomplete="off"
    data-env-form
    data-confirm
    data-confirm-title="Save these variables?"
    data-confirm-body="A variable you removed from the box is deleted; if the project or environment also sets it, that value applies again. Changes take effect on the next deploy."
    data-confirm-label="Save variables"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="res-vars-stack">Variables</label>
      <textarea id="res-vars-stack" name="runtime" rows="10" spellcheck="false" placeholder="POSTGRES_PASSWORD=..."><%= it.composeEnvText || '' %></textarea>
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save variables
      </button>
    </div>
  </form>
</div>
<% } else { %>
<div class="card stack">
  <h2 class="card-title">Resource variables</h2>
  <p class="muted">
    One <code>KEY=value</code> per line, in the box for where it is needed.
    Runtime variables reach the container; build variables reach the build and
    are baked into the image. Reference another variable with
    <code>${OTHER}</code>, and write <code>$$</code> for a literal
    <code>$</code>. Values are encrypted at rest and shown only here. The boxes
    show what is saved, and saving replaces it with what they hold.
  </p>
  <form
    method="post"
    action="/r/<%= it.resource.id %>/env"
    class="stack"
    autocomplete="off"
    data-env-form
    data-confirm
    data-confirm-title="Save these variables?"
    data-confirm-body="A variable you removed from the boxes is deleted; if the project or environment also sets it, that value applies again. Changes take effect on the next deploy."
    data-confirm-label="Save variables"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="scope-boxes">
      <div class="field">
        <label class="label" for="res-vars-runtime">Runtime only</label>
        <textarea id="res-vars-runtime" name="runtime" rows="8" spellcheck="false" placeholder="DATABASE_URL=postgres://..."><%= it.envText ? it.envText.runtime : '' %></textarea>
      </div>
      <div class="field">
        <label class="label" for="res-vars-build">Build only</label>
        <textarea id="res-vars-build" name="build" rows="8" spellcheck="false" placeholder="NPM_TOKEN=..."><%= it.envText ? it.envText.build : '' %></textarea>
      </div>
      <div class="field">
        <label class="label" for="res-vars-both">Both</label>
        <textarea id="res-vars-both" name="both" rows="8" spellcheck="false" placeholder="NODE_ENV=production"><%= it.envText ? it.envText.both : '' %></textarea>
      </div>
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save variables
      </button>
    </div>
  </form>
</div>
<% } %>
<% } %>

<% if (it.tab === 'domains') { %>
<div class="card stack">
  <h2 class="card-title">Domains</h2>
  <% if (isCompose) { %>
  <%/* A row with no service follows the public service, as the auto row
       does once Settings clears it; with no public service such rows go
       nowhere. Rows that name a service are routed whatever Settings says. */%>
  <% if (!routed && it.domains.some(function (d) { return d.serviceName === null })) { %>
  <div class="notice notice-warn">
    <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
    <div>
      Domains marked not routed follow the public service, and this stack has
      none. Point a custom domain at a service below, or
      <a href="/r/<%= it.resource.id %>?tab=settings">set a public service in Settings</a>
      and deploy — the automatic domain follows it.
    </div>
  </div>
  <% } %>
  <% } else if (it.domains.length > 0 && !it.resource.containerPort) { %>
  <div class="notice notice-warn">
    <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
    <div>
      These domains are not routed: this resource has no container port, so a
      deploy has nothing to send their traffic to.
      <a href="/r/<%= it.resource.id %>?tab=settings">Set one in Settings</a>,
      then deploy.
    </div>
  </div>
  <% } %>
  <% if (it.autoDomain) { %>
  <p class="muted">Automatic: <span class="mono"><%= it.autoDomain %></span></p>
  <% } else { %>
  <p class="muted">
    No wildcard domain configured, so there is no automatic subdomain. Set
    <code>MUSDASH_WILDCARD_DOMAIN</code> to enable it.
  </p>
  <% } %>
<% if (isCompose) { %>
<%
  /* A stack's domains each name a service and the port it listens on (D66).
     A custom domain's service and port are controls of the form in its last
     cell, tied to it by `form=` because a form cannot wrap a table row. The
     auto row follows the public service, which only Settings changes. A
     service whose name cannot be part of a hostname is listed but cannot be
     chosen. data-port is the one port a service already answers on, which
     stack.js fills in when the service is chosen; the server checks it. */
  var services = cs ? cs.services : []
  var ports = it.compose ? it.compose.servicePorts : {}
  var routable = it.compose ? it.compose.routableServices : []
  var portOf = function (name) { return Object.hasOwn(ports, name) ? ports[name] : null }
  var canRoute = function (name) { return routable.indexOf(name) !== -1 }
  var hasUnroutable = services.some(function (s) { return !canRoute(s) })
  var addService = cs && cs.publicService && canRoute(cs.publicService)
    ? cs.publicService
    : (routable.length === 1 ? routable[0] : null)
  var addPort = addService !== null && portOf(addService) !== null ? portOf(addService) : ''
%>
  <% if (!cs) { %>
  <p class="muted">This stack's saved settings could not be read, so its domains cannot be pointed at services here.</p>
  <% } %>
  <% if (it.domains.length > 0) { %>
  <div class="table-scroll">
    <table class="table domain-table">
      <thead>
        <tr>
          <th>Domain</th>
          <th>Service</th>
          <th>Port</th>
          <th><span class="vh">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% it.domains.forEach(function (d) {
          var editable = !d.isAuto && !!cs
          var formId = 'dt-' + d.id
          var followsPublic = d.serviceName === null && routed
        %>
        <tr>
          <td class="mono"><%= d.host %><%= d.isAuto ? ' (auto)' : '' %></td>
          <% if (!editable) { %>
          <% if (d.serviceName !== null) { %>
          <td class="mono"><%= d.serviceName %></td>
          <td><%= d.containerPort === null ? '—' : d.containerPort %></td>
          <% } else if (followsPublic) { %>
          <td>public service (<span class="mono"><%= cs.publicService %></span>)</td>
          <td><%= cs.publicPort %></td>
          <% } else { %>
          <td class="muted">Not routed</td>
          <td class="muted">—</td>
          <% } %>
          <% } else { %>
          <td>
            <select name="serviceName" form="<%= formId %>" required aria-label="Service for <%= d.host %>">
              <% if (d.serviceName === null) { %>
              <option value="" selected disabled><%= followsPublic ? 'public service (' + cs.publicService + ')' : 'Not routed' %></option>
              <% } else if (services.indexOf(d.serviceName) === -1) { %>
              <option value="" selected disabled><%= d.serviceName %> (not in the file)</option>
              <% } %>
              <% services.forEach(function (s) { var p = portOf(s) %>
              <option value="<%= s %>"<% if (p !== null) { %> data-port="<%= p %>"<% } %><% if (!canRoute(s)) { %> disabled<% } %><% if (s === d.serviceName) { %> selected<% } %>><%= s %><%= canRoute(s) ? '' : ' (name cannot carry a domain)' %></option>
              <% }) %>
            </select>
          </td>
          <td>
            <input name="containerPort" form="<%= formId %>" type="number" min="1" max="65535" required value="<%= d.containerPort !== null ? d.containerPort : (followsPublic ? cs.publicPort : '') %>" aria-label="Port for <%= d.host %>" />
          </td>
          <% } %>
          <td>
            <div class="row end">
              <% if (editable) { %>
              <form id="<%= formId %>" method="post" action="/r/<%= it.resource.id %>/domains/<%= d.id %>/target" class="inline">
                <input type="hidden" name="csrf" value="<%= it.csrf %>" />
                <button class="btn btn-sm" type="submit">
                  <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
                  Save
                </button>
              </form>
              <% } else if (d.isAuto) { %>
              <a class="btn btn-sm" href="/r/<%= it.resource.id %>?tab=settings">Change in Settings</a>
              <% } %>
              <%/* The auto domain follows the public service whether or not
                   its row exists (D66), so removing it would change nothing;
                   clearing the public service in Settings is how it stops. */%>
              <% if (!d.isAuto) { %>
              <form
                method="post"
                action="/r/<%= it.resource.id %>/domains/<%= d.id %>/delete"
                class="inline"
                data-confirm
                data-confirm-danger
                data-confirm-title="Remove this domain?"
                data-confirm-body="Traffic to this hostname will stop being routed here as soon as the change applies."
                data-confirm-label="Remove domain"
              >
                <input type="hidden" name="csrf" value="<%= it.csrf %>" />
                <button class="btn btn-danger btn-sm" type="submit">
                  <svg class="icon" aria-hidden="true"><use href="#i-x" /></svg>
                  Remove
                </button>
              </form>
              <% } %>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
  <% if (cs) { %>
  <form method="post" action="/r/<%= it.resource.id %>/domains" class="stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="res-domain">Custom domain</label>
      <%/* The same pattern as the image and git form below. */%>
      <input id="res-domain" name="host" placeholder="app.example.com" required pattern="(?=.{1,253}$)[a-zA-Z0-9]([a-zA-Z0-9\-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]*[a-zA-Z0-9])?)+" autocapitalize="none" spellcheck="false" aria-describedby="res-domain-hint" />
      <p class="hint" id="res-domain-hint">An A or AAAA record for it must point at this server. Its first certificate takes a few seconds to a minute after the name is added or deployed.</p>
      <p class="error">Enter a bare hostname such as app.example.com, without https:// or a path.</p>
    </div>
    <div class="row gap wrap domain-target">
      <div class="field">
        <label class="label" for="res-domain-service">Service</label>
        <select id="res-domain-service" name="serviceName" required aria-describedby="res-domain-service-hint">
          <option value="" disabled<% if (addService === null) { %> selected<% } %>>Choose a service</option>
          <% services.forEach(function (s) { var p = portOf(s) %>
          <option value="<%= s %>"<% if (p !== null) { %> data-port="<%= p %>"<% } %><% if (!canRoute(s)) { %> disabled<% } %><% if (s === addService) { %> selected<% } %>><%= s %><%= canRoute(s) ? '' : ' (name cannot carry a domain)' %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label class="label" for="res-domain-port">Port</label>
        <input id="res-domain-port" name="containerPort" type="number" min="1" max="65535" required value="<%= addPort %>" placeholder="80" />
      </div>
    </div>
    <p class="hint" id="res-domain-service-hint">
      The service this domain sends its traffic to, and the port that service
      listens on. A service has one port for all its domains. Pointing a domain
      at a service no domain reached at the last deploy redeploys a running
      stack, so that service can join the proxy's network.
      <% if (hasUnroutable) { %>
      A service whose name is longer than 26 characters, or uses anything but
      lowercase letters, digits and dashes, cannot carry a domain.
      <% } %>
    </p>
    <div class="row end">
      <button class="btn" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
        Add domain
      </button>
    </div>
  </form>
  <% } %>
<% } else { %>
  <ul class="plain">
    <% it.domains.forEach(function (d) { %>
    <li class="row between">
      <span class="mono"><%= d.host %><%= d.isAuto ? ' (auto)' : '' %></span>
      <form
        method="post"
        action="/r/<%= it.resource.id %>/domains/<%= d.id %>/delete"
        class="inline"
        data-confirm
        data-confirm-danger
        data-confirm-title="Remove this domain?"
        data-confirm-body="Traffic to this hostname will stop being routed here as soon as the change applies."
        data-confirm-label="Remove domain"
      >
        <input type="hidden" name="csrf" value="<%= it.csrf %>" />
        <button class="btn btn-danger btn-sm" type="submit">
          <svg class="icon" aria-hidden="true"><use href="#i-x" /></svg>
          Remove
        </button>
      </form>
    </li>
    <% }) %>
  </ul>
  <form method="post" action="/r/<%= it.resource.id %>/domains" class="stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="res-domain">Custom domain</label>
      <div class="row gap">
        <%/* HOSTNAME_RE (src/caddy/client.ts) plus its 253 limit, with capitals
             allowed because the server lowercases before checking. */%>
        <input id="res-domain" name="host" placeholder="app.example.com" required pattern="(?=.{1,253}$)[a-zA-Z0-9]([a-zA-Z0-9\-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]*[a-zA-Z0-9])?)+" autocapitalize="none" spellcheck="false" aria-describedby="res-domain-hint" />
        <button class="btn" type="submit">
          <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
          Add domain
        </button>
      </div>
      <p class="hint" id="res-domain-hint">An A or AAAA record for it must point at this server. Its first certificate takes a few seconds to a minute after the name is added or deployed.</p>
      <p class="error">Enter a bare hostname such as app.example.com, without https:// or a path.</p>
    </div>
  </form>
<% } %>
</div>
<% } %>

<% if (it.tab === 'settings') { %>
<% if (it.resource.kind === 'git') { %>
<div class="card stack">
  <h2 class="card-title">Source</h2>
  <dl class="kv">
    <dt>Repository</dt>
    <dd class="mono"><%= it.resource.gitRepo || '—' %></dd>
    <dt>Branch</dt>
    <dd class="mono"><%= it.resource.gitBranch || '—' %></dd>
    <dt>GitHub account</dt>
    <% if (it.gitLink.kind === 'linked') { %>
    <dd><%= it.gitLink.accountLogin %></dd>
    <% } else if (it.gitLink.kind === 'stale') { %>
    <dd>Installation removed</dd>
    <% } else { %>
    <dd class="muted">Not linked</dd>
    <% } %>
    <dt>Build pack</dt>
    <dd><%= it.resource.buildPack === 'dockerfile' ? 'Dockerfile' : 'Detected automatically (Railpack)' %></dd>
  </dl>

  <% if (it.gitLink.kind === 'stale') { %>
  <div class="notice notice-warn" role="status">
    <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
    <div>
      The GitHub installation this resource was linked to has been removed.
      Choose an account below and save, or choose None if the repository is
      public.
    </div>
  </div>
  <% } %>

  <!--
    A plain form, no Alpine: the account list comes from SQLite, so this page
    makes no GitHub call. The repository is typed rather than picked for the
    same reason. A stale or absent link preselects None, so saving without
    touching the select never writes back an installation that is gone.
  -->
  <form
    method="post"
    action="/r/<%= it.resource.id %>/source"
    class="stack"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="res-src-account">GitHub account</label>
      <select id="res-src-account" name="installationId">
        <option value="" <%= it.gitLink.kind !== 'linked' ? 'selected' : '' %>>None — public repo</option>
        <% it.githubInstallations.forEach(function (i) { %>
        <option value="<%= i.installationId %>" <%= it.gitLink.kind === 'linked' && String(i.installationId) === it.resource.gitInstallationId ? 'selected' : '' %>><%= i.accountLogin %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label class="label" for="res-src-repo">Repository</label>
      <input id="res-src-repo" name="repo" value="<%= it.resource.gitRepo || '' %>" required placeholder="owner/name" autocapitalize="none" spellcheck="false" />
    </div>
    <div class="field">
      <label class="label" for="res-src-branch">Branch</label>
      <%/* Same pattern and message as the create form in project.eta, which
           mirrors isValidGitRef (src/github/repos.ts). */%>
      <input id="res-src-branch" name="branch" value="<%= it.resource.gitBranch || '' %>" required pattern="(?!/)(?!.*\.\.)[^\x00-\x1f\x7f \~\^\:\?\*\[\\]{1,255}" placeholder="main" autocapitalize="none" spellcheck="false" />
      <p class="error">No spaces, no "..", no leading "/", and none of ~ ^ : ? * [ \</p>
    </div>
    <p class="hint">Saving does not deploy. The next deploy or push builds from the source set here.</p>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save source
      </button>
    </div>
  </form>

  <!--
    An unchecked checkbox submits nothing at all, which is exactly how "off" is
    expressed here — the handler reads an absent `enabled` as off. The page
    reloads from the database after Save, so what is drawn is what is stored.
  -->
  <form
    method="post"
    action="/r/<%= it.resource.id %>/auto-deploy"
    class="stack"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="checkline">
        <input type="checkbox" name="enabled" value="on" aria-describedby="res-auto-hint" <%= it.resource.autoDeploy ? 'checked' : '' %> />
        Deploy automatically when someone pushes to
        <span class="mono"><%= it.resource.gitBranch || 'the tracked branch' %></span>
      </label>
      <p class="hint" id="res-auto-hint">
        Requires the GitHub App's webhook to reach this instance. A push to any
        other branch is ignored.
      </p>
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
</div>
<% } %>

<% if (isCompose) { %>
<%
  /* A refused save comes back here from a session-keyed draft, never the
     URL: the file can hold secrets. The draft wins over what is saved, since
     nothing was saved. Every value below goes through the escaping tag,
     never the raw one: the file is attacker-influenced text, and a
     `</textarea>` in it must stay text. */
  var draft = it.composeDraft || null
  var fileText = draft ? draft.text : (cs ? cs.composeFile : '')
  var serviceText = draft ? draft.publicService : (cs && cs.publicService ? cs.publicService : '')
  var portText = draft ? draft.publicPort : (cs && cs.publicPort ? cs.publicPort : '')
  var healthText = draft ? draft.healthPath : (it.resource.healthPath || '')
%>
<div class="card stack">
  <h2 class="card-title">Settings</h2>
  <% if (!cs && !draft) { %>
  <%/* A save needs the stored source to merge into, so the server refuses
       one here; offering an empty form would only lead to a 400. */%>
  <div class="notice notice-warn" role="status">
    <svg class="icon" aria-hidden="true"><use href="#i-alert" /></svg>
    <div>This stack's saved settings could not be read, so they cannot be edited here. Delete the stack and create it again from its Compose file.</div>
  </div>
  <% } else { %>
  <form method="post" action="/r/<%= it.resource.id %>/settings" class="stack" autocomplete="off" data-compose-form>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <% if (draft && draft.refusal) { %>
    <div class="notice notice-error" role="alert">
      <svg class="icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
      <div><%~ include("@compose-refusal", { refusal: draft.refusal }) %></div>
    </div>
    <% } %>
    <div class="field">
      <label class="label" for="res-compose-file">Compose file</label>
      <%/* The newline after the start tag is dropped by the HTML parser, so a
           file that itself starts with a newline keeps it. */%>
      <textarea id="res-compose-file" class="compose-file" name="composeFile" required spellcheck="false" autocomplete="off" autocapitalize="none" rows="18" maxlength="65536" aria-describedby="res-compose-file-hint">
<%= fileText %></textarea>
      <p class="hint" id="res-compose-file-hint">
        Images only — build:, ports:, bind mounts and privileged are refused.
        Named volumes keep their data across deploys. Saving does not deploy;
        the next Deploy uses the file saved here.
      </p>
    </div>
    <div class="field">
      <label class="label" for="res-compose-service">Public service <span class="opt">optional</span></label>
      <input id="res-compose-service" name="publicService" value="<%= serviceText %>" placeholder="web" autocapitalize="none" spellcheck="false" aria-describedby="res-compose-service-hint" />
      <p class="hint" id="res-compose-service-hint">The service that gets this resource's address. Leave it empty for a stack with no website. Its name must be at most 26 lowercase letters, digits and dashes. A change reaches the address after the next Deploy.</p>
    </div>
    <div class="field">
      <label class="label" for="res-compose-port">Public port <span class="opt">optional</span></label>
      <input id="res-compose-port" name="publicPort" type="number" min="1" max="65535" value="<%= portText %>" placeholder="80" aria-describedby="res-compose-port-hint" />
      <p class="hint" id="res-compose-port-hint">The port that service listens on. Required with a public service.</p>
    </div>
    <div class="field">
      <label class="label" for="res-compose-health">Health path <span class="opt">optional</span></label>
      <input id="res-compose-health" name="healthPath" value="<%= healthText %>" placeholder="/health" />
    </div>
    <p class="hint">
      Each service's memory limit comes from <code>mem_limit</code> in the file;
      a service without one gets <%= it.defaultMemoryMb %> MB. Every container
      has a limit. There is no unlimited option.
    </p>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
  <% } %>
</div>
<% } else { %>
<div class="card stack">
  <h2 class="card-title">Settings</h2>
  <form method="post" action="/r/<%= it.resource.id %>/settings" class="stack">
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <% if (it.resource.kind === 'git') { %>
    <!--
      A git resource builds its own image, so there is nothing to type here and
      the handler ignores the field for this kind. It stays present but hidden
      because the body schema requires it; making it a visible `required` input
      would block the form outright before the first build has produced a tag.
    -->
    <input type="hidden" name="image" value="" />
    <p class="muted">
      The image is produced by each build from
      <span class="mono"><%= it.resource.gitRepo || 'the source' %></span>, so
      there is nothing to set here.
    </p>
    <% } else { %>
    <div class="field">
      <label class="label" for="res-image">Docker image</label>
      <input id="res-image" name="image" value="<%= it.image %>" required />
    </div>
    <% } %>
    <div class="field">
      <label class="label" for="res-port">Container port <span class="opt">optional</span></label>
      <input id="res-port" name="containerPort" type="number" min="1" max="65535" value="<%= it.resource.containerPort || '' %>" />
    </div>
    <div class="field">
      <label class="label" for="res-health">Health path <span class="opt">optional</span></label>
      <input id="res-health" name="healthPath" value="<%= it.resource.healthPath || '' %>" />
    </div>
    <div class="field">
      <label class="label" for="res-memory">Memory limit (MB)</label>
      <input id="res-memory" name="memoryLimitMb" type="number" min="16" max="65536" value="<%= it.resource.memoryLimitMb %>" required aria-describedby="res-memory-hint" />
      <p class="hint" id="res-memory-hint">Every container has a limit. There is no unlimited option.</p>
    </div>
    <div class="row end">
      <button class="btn btn-primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
        Save
      </button>
    </div>
  </form>
</div>
<% } %>

<div class="card card-danger stack">
  <h2 class="card-title">Delete resource</h2>
  <% if (isCompose) { %>
  <p class="muted">
    Stops and removes every service's container, the stack's routes and its
    deployment history. Named volumes are kept, with their data. This cannot
    be undone.
  </p>
  <% } else { %>
  <p class="muted">
    Stops and removes the container, its route and its volumes. This cannot be
    undone.
  </p>
  <% } %>
  <form
    method="post"
    action="/r/<%= it.resource.id %>/delete"
    data-confirm
    data-confirm-danger
    data-confirm-title="Delete this resource?"
    <% if (isCompose) { %>
    data-confirm-body="Every service's container, the stack's routes and its deployment history are removed. Named volumes are kept, with their data. This cannot be undone."
    <% } else { %>
    data-confirm-body="The container, its route, its volumes and its deployment history are removed. This cannot be undone."
    <% } %>
    data-confirm-label="Delete resource"
  >
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <button class="btn btn-danger" type="submit">
      <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
      Delete this resource
    </button>
  </form>
</div>
<% } %>
