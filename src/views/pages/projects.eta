<div class="page-head">
  <h1>Projects</h1>
  <button type="button" class="btn btn-primary" data-open="new-project" commandfor="new-project" command="show-modal">
    <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
    New project
  </button>
</div>

<% if (it.projects.length === 0) { %>
<div class="empty card">
  <h2>No projects yet</h2>
  <p class="muted">
    A project holds environments, and an environment holds the apps you deploy.
    Create one to get started — it comes with a <code>production</code>
    environment ready to use.
  </p>
  <button type="button" class="btn btn-primary" data-open="new-project" commandfor="new-project" command="show-modal">
    <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>
    Create your first project
  </button>
</div>
<% } else { %>
<div class="grid">
  <% it.projects.forEach(function (p) { %>
  <a class="card project" href="/p/<%= p.project.id %>">
    <h3 class="card-title"><%= p.project.name %></h3>
    <% if (p.project.description) { %>
    <p class="muted"><%= p.project.description %></p>
    <% } %>
    <div class="meta">
      <span><%= p.environmentCount %> environment<%= p.environmentCount === 1 ? '' : 's' %></span>
      <span><%= p.resourceCount %> resource<%= p.resourceCount === 1 ? '' : 's' %></span>
    </div>
  </a>
  <% }) %>
</div>
<% } %>

<dialog id="new-project" aria-labelledby="new-project-title">
  <form method="post" action="/projects" class="stack">
    <header class="dialog-head"><h2 id="new-project-title">New project</h2></header>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <div class="field">
      <label class="label" for="new-project-name">Name</label>
      <input id="new-project-name" name="name" required pattern="[A-Za-z0-9 _\-]{1,60}" autofocus />
      <p class="error">Use letters, digits, spaces, dashes and underscores, up to 60 characters.</p>
    </div>
    <div class="field">
      <label class="label" for="new-project-description">Description <span class="opt">optional</span></label>
      <input id="new-project-description" name="description" maxlength="200" />
    </div>
    <div class="dialog-foot">
      <button type="button" class="btn" data-close commandfor="new-project" command="close">Cancel</button>
      <button type="submit" class="btn btn-primary">Create</button>
    </div>
  </form>
</dialog>
