<div class="page-head">
  <h1>Projects</h1>
  <button class="primary" onclick="document.getElementById('new-project').showModal()">
    New project
  </button>
</div>

<% if (it.projects.length === 0) { %>
<div class="empty card">
  <h2>No projects yet</h2>
  <p class="muted">
    A project holds environments, and an environment holds the apps you deploy.
    Create one to get started — it comes with a <code>production</code>
    environment ready to use.
  </p>
  <button class="primary" onclick="document.getElementById('new-project').showModal()">
    Create your first project
  </button>
</div>
<% } else { %>
<div class="grid">
  <% it.projects.forEach(function (p) { %>
  <a class="card project" href="/p/<%= p.project.id %>">
    <h3><%= p.project.name %></h3>
    <% if (p.project.description) { %>
    <p class="muted"><%= p.project.description %></p>
    <% } %>
    <div class="meta">
      <span><%= p.environmentCount %> environment<%= p.environmentCount === 1 ? '' : 's' %></span>
      <span><%= p.resourceCount %> resource<%= p.resourceCount === 1 ? '' : 's' %></span>
    </div>
  </a>
  <% }) %>
</div>
<% } %>

<dialog id="new-project">
  <form method="post" action="/projects" class="stack">
    <h2>New project</h2>
    <input type="hidden" name="csrf" value="<%= it.csrf %>" />
    <label>
      Name
      <input name="name" required pattern="[A-Za-z0-9 _-]{1,60}" autofocus />
    </label>
    <label>
      Description <small class="muted">optional</small>
      <input name="description" maxlength="200" />
    </label>
    <div class="row end">
      <button type="button" class="link" onclick="this.closest('dialog').close()">
        Cancel
      </button>
      <button type="submit" class="primary">Create</button>
    </div>
  </form>
</dialog>
