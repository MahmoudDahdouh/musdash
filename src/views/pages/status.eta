<div class="narrow">
  <% if (it.status === 400) { %>
  <h1>That request was not valid</h1>
  <p>Go back and try again. If the page had been open a long time, reload it first.</p>
  <% } else if (it.status === 403) { %>
  <h1>This page had expired</h1>
  <%/* Not just "reload": reloading this page re-posts the stale token. */%>
  <p>Nothing was saved. Go back, reload that page, then try again.</p>
  <% } else if (it.status === 404) { %>
  <h1>Not found</h1>
  <p>There is nothing at this address.</p>
  <% } else if (it.status === 413) { %>
  <h1>That form was too large</h1>
  <p>musdash accepts forms up to <%= it.limitKb %> KB, and nothing was saved. If you were saving environment variables, split them across the project, environment and resource levels, or remove ones that are no longer needed, then try again.</p>
  <% } else { %>
  <h1>Something went wrong</h1>
  <p>The details are in the server logs: <code>journalctl -u musdash</code>.</p>
  <% } %>
  <p><a class="btn" href="/">Back to projects</a></p>
</div>
