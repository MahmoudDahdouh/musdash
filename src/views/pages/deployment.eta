<div class="breadcrumbs">
  <a href="/">Projects</a> <span>/</span>
  <a href="/r/<%= it.resource.id %>"><%= it.resource.name %></a> <span>/</span>
  deployment
</div>

<div class="page-head">
  <div class="row gap" x-data="deploymentStatus('<%= it.deployment.id %>', '<%= it.deployment.status %>')">
    <h1 class="mono"><%= it.deployment.image %></h1>
    <%~ include("@status", { state: it.deployment.status, live: true }) %>
  </div>
  <a class="btn btn-quiet" href="/r/<%= it.resource.id %>">Back to resource</a>
</div>

<div class="card" x-data="logPanel('/d/<%= it.deployment.id %>/logs')">
  <div class="row between">
    <h3 class="card-title">Deploy log</h3>
    <button class="btn btn-quiet btn-sm" x-show="paused" x-cloak @click="resume()">
      <svg class="icon" aria-hidden="true"><use href="#i-arrow-down" /></svg>
      Jump to latest
    </button>
  </div>
  <pre class="logs" x-ref="box" @scroll="onScroll()"><% it.lines.forEach(function (l) { %><span><%= l %></span>
<% }) %></pre>
</div>

<% if (it.deployment.error) { %>
<div class="notice notice-error" role="alert">
  <svg class="icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
  <div><%= it.deployment.error %></div>
</div>
<% } %>
