<div class="page-head">
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a class="link-quiet" href="/">Projects</a></li>
      <li><a class="link-quiet" href="/p/<%= it.project.id %>"><%= it.project.name %></a></li>
      <li><a class="link-quiet" href="/p/<%= it.project.id %>#env-<%= it.environment.id %>"><%= it.environment.name %></a></li>
      <li><a class="link-quiet" href="/r/<%= it.resource.id %>"><%= it.resource.name %></a></li>
      <li aria-current="page">Deployment</li>
    </ol>
  </nav>
  <div class="page-title" x-data="deploymentStatus('<%= it.deployment.id %>', '<%= it.deployment.status %>')">
    <h1>Deployment</h1>
    <%~ include("@status", { state: it.deployment.status, live: true }) %>
    <p class="mono muted"><%~ include("@deploy-image", { pending: it.imagePending, status: it.deployment.status, image: it.deployment.image }) %></p>
  </div>
  <div class="actions">
    <a class="btn btn-quiet" href="/r/<%= it.resource.id %>">Back to resource</a>
    <%/* Only a queued deploy can be cancelled; once the worker has claimed it
         the route answers with a notice instead. A reconciler deploy heals
         drift and would only be queued again, so it gets no button. */%>
    <% if (it.deployment.status === 'queued' && it.deployment.trigger !== 'reconcile') { %>
    <form
      method="post"
      action="/d/<%= it.deployment.id %>/cancel"
      class="inline"
      data-confirm
      data-confirm-danger
      data-confirm-title="Remove this deploy from the queue?"
      data-confirm-body="Nothing is built or deployed, and what is running now keeps running.<%= it.deployment.trigger === 'rollback' || it.deployment.trigger === 'redeploy' ? '' : it.resource && it.resource.kind === 'git' ? ' Pushes and Deploy clicks that arrived while it waited were folded into it, so they are dropped too. Push again or press Deploy to build the branch.' : ' Deploy clicks that arrived while it waited were folded into it, so they are dropped too. Press Deploy to queue it again.' %>"
      data-confirm-label="Remove from queue"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button class="btn" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-x" /></svg>
        Cancel deploy
      </button>
    </form>
    <% } %>
    <%/* The route passes `redeploy` only for a finished deployment it can repeat.
         The confirm names what will actually happen: a git row with a commit may
         be built again, one without can only reuse its image, and an image
         resource pulls the reference again. */%>
    <% if (it.redeploy) {
      var rd = it.redeploy
      var rdTitle, rdBody
      if (rd.kind === 'git' && rd.sha7) {
        rdTitle = 'Deploy commit ' + rd.sha7 + ' again?'
        rdBody = 'If the image built for this commit is still on this server it is reused; otherwise commit ' + rd.sha7 + ' is built again. Either way it runs with the resource\'s current variables and settings, and traffic only switches once it passes the health check.'
      } else if (rd.kind === 'git') {
        rdTitle = 'Deploy this image again?'
        rdBody = 'Reuses ' + rd.image + ' from this server; it is never pulled from a registry. It runs with the resource\'s current variables and settings, and traffic only switches once it passes the health check.'
      } else {
        rdTitle = 'Deploy ' + rd.image + ' again?'
        rdBody = 'Pulls ' + rd.image + ' again, so a tag that has moved gets its newest version, and makes it this resource\'s image. Traffic only switches once it passes the health check.'
      }
    %>
    <form
      method="post"
      action="/d/<%= it.deployment.id %>/redeploy"
      class="inline"
      data-confirm
      data-confirm-title="<%= rdTitle %>"
      data-confirm-body="<%= rdBody %>"
      data-confirm-label="Deploy again"
    >
      <input type="hidden" name="csrf" value="<%= it.csrf %>" />
      <button class="btn" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-rotate-ccw" /></svg>
        Deploy this again
      </button>
    </form>
    <% } %>
  </div>
</div>

<%
  /* Timestamps are stored as ISO UTC; shown to the minute, labelled UTC,
     with the exact value kept in <time datetime>. */
  var d = it.deployment
  var emptyLog = {
    queued: 'Queued. Deploys run one at a time, so this one may be behind another.',
    running: 'Waiting for the first line.',
    cancelled: 'Cancelled before it started, so nothing was deployed.',
  }[d.status] || 'No log lines to show. Deploy logs are held in memory only: they are cleared about ten minutes after a deploy finishes, once fifty newer deploys have run, or when musdash restarts.'
%>
<dl class="kv-strip">
  <div>
    <dt>Started</dt>
    <dd><% if (d.startedAt) { %><time datetime="<%= d.startedAt %>"><%= d.startedAt.slice(0, 16).replace('T', ' ') %> UTC</time><% } else { %>Not started<% } %></dd>
  </div>
  <div>
    <dt>Duration</dt>
    <dd><%= it.duration %></dd>
  </div>
  <div>
    <dt>Trigger</dt>
    <dd><%= d.trigger %></dd>
  </div>
  <% if (d.commitSha) { %>
  <div>
    <dt>Commit</dt>
    <dd class="mono" title="<%= d.commitMessage ? d.commitMessage.split('\n')[0] : '' %>"><%= d.commitSha.slice(0, 7) %></dd>
  </div>
  <% } %>
</dl>

<% if (d.error) { %>
<div class="notice notice-error" role="alert">
  <svg class="icon" aria-hidden="true"><use href="#i-x-circle" /></svg>
  <div><%= d.error %></div>
</div>
<% } %>

<%/* Set only on the build that made the switch (D64); reuse, rollback, and
     reconcile rows leave it null, so the note never shows there. */%>
<% if (d.autoWebpackCapMib != null) { %>
<div class="notice notice-info" role="status">
  <svg class="icon" aria-hidden="true"><use href="#i-info" /></svg>
  <div>
    <strong>Built with webpack.</strong>
    Next.js's default bundler, Turbopack, needs about 1.25 GiB of memory to
    build, and this server gives builds <%= d.autoWebpackCapMib %> MiB. To
    choose the build command yourself, set the build variable
    <code>RAILPACK_BUILD_CMD</code> on
    <a href="/r/<%= it.resource.id %>">this resource</a>.
  </div>
</div>
<% } %>

<%/* The stream starts after the lines drawn below, so none shows twice. */%>
<div class="card stack" x-data="logPanel('/d/<%= d.id %>/logs?skip=<%= it.lines.length %>')">
  <h2 class="card-title">Deploy log</h2>
  <%/* The empty-state message sits flush against <pre>: pre-wrap would show any
       template whitespace. CSS hides it once a line arrives. */%>
  <div class="logs-wrap">
    <pre class="logs logs-lg" x-ref="box" @scroll="onScroll()"><% if (it.lines.length === 0) { %><span class="logs-empty"><%= emptyLog %></span><% } %><% it.lines.forEach(function (l) { %><span><%= l %></span>
<% }) %></pre>
    <button class="btn btn-sm" x-show="paused" x-cloak @click="resume()">
      <svg class="icon" aria-hidden="true"><use href="#i-arrow-down" /></svg>
      Jump to latest
    </button>
  </div>
</div>
