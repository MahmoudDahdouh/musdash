{
  "compilerOptions": {
    // Bun transpiles and runs TypeScript directly; tsc is only a type checker
    // here, so nothing is emitted.
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "strict": true,
    // Forces the demux buffer code to be honest about partial reads: indexing
    // a byte that may not have arrived yet is a type error, not a silent
    // undefined.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "scripts/**/*", ".claude/hooks/**/*"]
}
